<%= form_with(model: movimentacao, id: "form-movimentacao-manual") do |form| %>
  
  <%# EXIBIÇÃO DE ERROS NO PADRÃO TONAL PREMIUM %>
  <% if movimentacao.errors.any? %>
    <div style="color: #dc2626; background: #fef2f2; padding: 18px; border-radius: 8px; margin-bottom: 25px; border: 1px solid #fee2e2; text-align: left; box-sizing: border-box; font-family: sans-serif; font-size: 14px;">
      <h2 style="font-size: 15px; font-weight: bold; margin-top: 0; text-transform: uppercase; letter-spacing: 0.3px;">
        <%= movimentacao.errors.count == 1 ? "1 erro impediu" : "#{movimentacao.errors.count} erros impediram" %> de salvar:
      </h2>
      <ul style="margin: 8px 0 0 0; padding-left: 20px; color: #b91c1c; line-height: 1.4;">
        <% movimentacao.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 1. SELEÇÃO DO ITEM %>
  <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
    <%= form.label :produto_id, "Item (Produto ou Insumo)", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.select :produto_id, 
        options_for_select(
          [["--- SELECIONE UM ITEM ---", ""]] + 
          Produto.where(categoria: ["Venda", nil]).order(:nome).map { |p| ["[PRODUTO] #{p.nome.upcase}", "PRODUTO-#{p.id}"] } + 
          Insumo.order(:nome).map { |i| ["[INSUMO] #{i.nome.upcase}", "INSUMO-#{i.id}"] }
        ), 
        {}, 
        { style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background-color: white; outline: none; color: #1e293b; height: 41px; font-weight: 500;" } %>
  </div>

  <%# 2. SELEÇÃO DA UNIDADE (Ajustado para salvar o ID) %>
<div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
  <%= form.label :unidade_id, "Unidade de Destino", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
  
  <%= form.collection_select :unidade_id, 
      Unidade.all, :id, :nome, 
      { prompt: "Selecione o posto de destino..." }, 
      { style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background-color: white; outline: none; color: #1e293b; height: 41px; font-weight: 500;" } %>
</div>

  <%# 3. QUANTIDADE ADICIONAL %>
  <div style="margin-bottom: 30px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
    <%= form.label :quantidade, "Quantidade Adicional", style: "font-size: 11px; font-weight: bold; color: #16a34a; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.number_field :quantidade, step: :any, min: 0.001, placeholder: "0,000", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; outline: none; color: #1e293b; font-weight: bold;" %>
  </div>

  <%# BOTÃO DE SUBMISSÃO EXECUTIVO EM CAIXA %>
  <div style="text-align: center; margin-top: 10px; font-family: sans-serif; box-sizing: border-box; width: 100%;">
    <%= form.submit "REGISTRAR ENTRADA MANUAL", style: "width: 100%; padding: 14px; background-color: #D71920; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215, 25, 32, 0.18); letter-spacing: 0.5px; text-transform: uppercase; box-sizing: border-box;" %>
  </div>

<% end %>