<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || "Quero Lanches - Sistema de Gestão" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Quero Lanches">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.js"></script>
  </head>

  <body>
    <nav class="navbar-quero">
      <%# Logo centralizada com link para a home %>
      <%= link_to root_path do %>
        <%= image_tag "logo.png", size: "100x100", alt: "Logo Quero Lanches" %>
      <% end %>

      <%# Botão de Início %>
      <div style="margin-top: 10px;">
        <%= link_to "INÍCIO / ALERTAS", root_path, style: "text-decoration: none; color: white; background: #D71920; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 0.8em; border: 2px solid white;" %>
      </div>
    </nav>
      
    <div style="margin-top: 15px; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; align-items: center;">
      <% if funcionario_signed_in? %>
        
        <%# --- SEÇÃO OPERACIONAL (Disponível para todos) --- %>
        <%= link_to "CARDÁPIO", cardapio_index_path, class: "nav-link-quero" %>
        <%= link_to "PEDIDOS", pedidos_path, class: "nav-link-quero" %>
        <%= link_to "DESPESAS", despesas_path, class: "nav-link-quero" %>
        <%= link_to "ESTOQUE", estoques_path, class: "nav-link-quero" %>

        <% if current_funcionario.admin? %>
          <%# Separador visual para o Admin %>
          <span style="margin: 0 5px; color: #ccc;">|</span>

          <%# --- SEÇÃO ADMINISTRATIVA (Apenas Admin) --- %>
          <%= link_to "CADASTRO", produtos_path, class: "nav-link-quero", title: "Produtos" %>
          <%= link_to "FUNCIONÁRIOS", funcionarios_path, class: "nav-link-quero" %>
          <%= link_to "FATURAMENTO", faturamentos_path, class: "nav-link-quero" %>
          <%= link_to "RELATÓRIOS", relatorios_path, class: "nav-link-quero" %>
          <%= link_to 'AUDITORIA', auditoria_path, class: "nav-link-quero" %>
        <% end %>

        <%# Botão de Sair %>
        <%= link_to "SAIR", "/funcionarios/sign_out", class: "nav-link-quero", 
            style: "border: 2px solid #D71920; padding: 5px 15px; border-radius: 20px; font-size: 13px; margin-left: 10px;" %>
      
      <% else %>
        <%= link_to "ENTRAR", new_funcionario_session_path, class: "nav-link-quero" %>
      <% end %>
    </div>

    <div style="padding: 20px;">
      <% if notice %>
        <p style="padding: 15px; background-color: #d4edda; color: #155724; border-radius: 10px; text-align: center; margin: 10px;">
          <%= notice %>
        </p>
      <% end %>

      <% if alert %>
        <p style="padding: 15px; background-color: #f8d7da; color: #721c24; border-radius: 10px; text-align: center; margin: 10px;">
          <%= alert %>
        </p>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>