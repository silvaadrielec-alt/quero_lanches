<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || "Quero Lanches - Sistema de Gestão" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Quero Lanches">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# --- CDN DO TOM SELECT IMPORTADA DE FORMA GLOBAL NO TOPO --- %>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/js/tom-select.complete.min.js"></script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.js"></script>

    <%# --- ESTILIZAÇÃO DO MENU SUSPENSO E DO SININHO --- %>
    <style>
      .dropdown-quero {
        position: relative;
        display: inline-block;
        /* Base invisível para o mouse descer sem perder o contato */
        padding-bottom: 15px; 
        margin-bottom: -15px;
      }

      .dropdown-conteudo {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 220px;
        box-shadow: 0px 8px 24px rgba(0,0,0,0.15);
        border: 2px solid #D71920;
        border-radius: 15px;
        z-index: 1000;
        
        margin-top: 0px; 
        padding-top: 5px; 
        
        left: 50%;
        transform: translateX(-50%);
        overflow: hidden;
      }

      .dropdown-conteudo a {
        color: #333 !important;
        padding: 12px 20px;
        text-decoration: none;
        display: block;
        font-family: sans-serif;
        font-weight: bold;
        font-size: 14px;
        text-align: left;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.2s;
      }

      .dropdown-conteudo a:hover {
        background-color: #fcebeb;
        color: #D71920 !important;
      }

      .dropdown-quero:hover .dropdown-conteudo {
        display: block;
      }
      
      .dropdown-quero:hover .nav-link-quero {
        background: #D71920;
        color: white !important;
      }

      /* ESTILO DO BALÃO NOTIFICADOR DO SININHO */
      .container-sininho {
        position: relative;
        display: inline-block;
      }

      .badge-sininho {
        position: absolute;
        top: -6px;
        right: -4px;
        background-color: #D71920;
        color: white;
        border-radius: 50%;
        padding: 2px 6px;
        font-size: 10px;
        font-weight: bold;
        border: 2px solid white;
        font-family: sans-serif;
      }
    </style>
  </head>

  <body>
    <nav class="navbar-quero">
      <%# Logo centralizada com link para a home %>
      <%= link_to root_path do %>
        <%= image_tag "logo.png", alt: "Logo Quero Lanches", class: "logo-sistema" %>
      <% end %>

      <%# Botão de Início %>
      <div style="margin-top: 10px;">
        <%= link_to "INÍCIO / ALERTAS", root_path, style: "text-decoration: none; color: white; background: #D71920; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 0.8em; border: 2px solid white;" %>
      </div>
    </nav>
      
    <div style="margin-top: 15px; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; align-items: center;">
      <% if funcionario_signed_in? %>
        
        <%# --- LINKS COMUNS (Visíveis para TODOS os níveis de acesso) --- %>
        <%= link_to "PEDIDOS", pedidos_path, class: "nav-link-quero" %>
        
        <% if current_funcionario.admin? %>
          <%# --- VISÃO DO ADMIN --- %>
          <div class="dropdown-quero">
            <span class="nav-link-quero no-print" style="cursor: pointer; padding-right: 15px;">
              CADASTROS ▼
            </span>
            <div class="dropdown-conteudo">
              <%= link_to "Cardápio", cardapio_index_path %>
              <%= link_to "Produtos", produtos_path %>
              <%= link_to "Insumos", insumos_path %>
              <%= link_to "Fichas Técnicas", gerenciar_composicoes_path %>
              <%= link_to "Despesas", despesas_path %>
              <%# ✂️ LINHA DE MOVIMENTAÇÕES REMOVIDA DAQUI %>
              <%= link_to "Reposição de Estoque", estoques_path %>
              <%= link_to "Funcionários", funcionarios_path %>
            </div>
          </div>
        <% else %>
          <%# --- VISÃO DO FUNCIONÁRIO COMUM --- %>
          <%= link_to "CARDÁPIO", cardapio_index_path, class: "nav-link-quero" %>
          <%= link_to "DESPESAS", despesas_path, class: "nav-link-quero" %>
        <% end %>
        
        <% if current_funcionario.admin? %>
          <span class="no-print" style="margin: 0 5px; color: #ccc;">|</span>

          <%# --- SEÇÃO ADMINISTRATIVA EXCLUSIVA --- %>
          <%= link_to "FATURAMENTO", faturamentos_path, class: "nav-link-quero" %>
          <%= link_to "FLUXO DE CAIXA", fluxo_de_caixa_path, class: "nav-link-quero" %>
          <%# 🌟 NOVA POSIÇÃO: Inserido como um botão direto do menu principal %>
          <%= link_to "MOVIMENTAÇÕES DE ESTOQUE", movimentacaos_path, class: "nav-link-quero" %>
          <%= link_to "RELATÓRIOS", relatorios_path, class: "nav-link-quero" %>
          <%# 🌟 O NOVO CORAÇÃO DA FISCALIZAÇÃO DO DINHEIRO %>
          <%= link_to 'AUDITORIA FINANCEIRA', auditorias_path, class: "nav-link-quero" %>
        <% end %>

       <div class="container-sininho" style="margin-left: 5px;">
        <%#  Esta tag faz o navegador "ouvir" o canal de rádio que criamos no Model %>
        <%= turbo_stream_from "notificacoes_global" %>

        <%= link_to notificacaos_path, class: "nav-link-quero", style: "text-decoration: none;", id: "sininho-container" do %>
        🔔 Alertas
        <%# Renderiza o parcial do badge pela primeira vez ao carregar a página %>
        <%= render "notificacaos/badge" %>
       <% end %>
       </div>

        <%# Botão de Sair %>
        <%= link_to "SAIR", destroy_funcionario_session_path, 
            data: { turbo_method: :delete }, 
            class: "nav-link-quero", 
            style: "border: 2px solid #D71920; padding: 5px 15px; border-radius: 20px; font-size: 13px; margin-left: 10px;" %>
      
      <% else %>
        <%= link_to "ENTRAR", new_funcionario_session_path, class: "nav-link-quero" %>
      <% end %>
    </div>

    <div style="padding: 20px;">
      <% if notice %>
        <p style="padding: 15px; background-color: #d4edda; color: #155724; border-radius: 10px; text-align: center; margin: 10px;">
          <%= notice %>
        </p>
      <% end %>

      <% if alert %>
        <p style="padding: 15px; background-color: #f8d7da; color: #721c24; border-radius: 10px; text-align: center; margin: 10px;">
          <%= alert %>
        </p>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>