<% if notice.present? %>
  <p style="color: #16a34a; font-weight: bold; text-align: center; font-family: sans-serif; font-size: 14px; margin-bottom: 15px;"><%= notice %></p>
<% end %>

<%# BOTÃO EXECUTIVO COMPACTO DE RETORNO NO TOPO %>
<div style="max-width: 600px; margin: 20px auto 15px auto; padding: 0 10px; box-sizing: border-box; text-align: left;">
  <%= link_to insumos_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px; font-family: sans-serif;" do %>
    ← VOLTAR PARA INSUMOS
  <% end %>
</div>

<%# CARD PRINCIPAL DE DETALHES COM MOLDURA VERMELHA OFICIAL %>
<div class="card-principal" style="max-width: 600px; margin: 0 auto 40px auto; padding: 35px; background: #fff; border-radius: 12px; border: 2px solid #D71920 !important; box-shadow: 0 4px 15px rgba(0,0,0,0.06); font-family: sans-serif; box-sizing: border-box;">
  
  <h1 style="color: #D71920; margin-top: 0; margin-bottom: 30px; font-size: 1.8em; text-align: center; font-weight: bold; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px; letter-spacing: 0.5px;">
    Detalhes do Insumo
  </h1>

  <%# BLOCO DE INFORMAÇÕES %>
  <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 35px; box-sizing: border-box;">
    
    <%# NOME %>
    <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; text-align: left;">
      <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.3px;">Nome do Insumo / Matéria-Prima</span>
      <strong style="font-size: 1.4em; color: #1e293b; text-transform: uppercase;"><%= @insumo.nome %></strong>
    </div>

    <%# PREÇO DE VENDA AND UNIDADE DE MEDIDA %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; text-align: left; box-sizing: border-box;">
      <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
        <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.3px;">Preço cobrado como Adicional</span>
        <span style="font-size: 1.25em; color: #16a34a; font-weight: bold;">
          <%= number_to_currency(@insumo.preco_venda, unit: "R$ ", separator: ",", delimiter: ".") %>
        </span>
      </div>

      <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
        <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.3px;">Unidade de Armazenamento</span>
        <span style="font-size: 1.25em; color: #1e293b; font-weight: bold; text-transform: uppercase;">
          <%= @insumo.unidade_medida.presence || "Não informada" %>
        </span>
      </div>
    </div>

    <%# FATOR DE RENDIMENTO TONAL CORPORATIVO %>
    <div style="background-color: #fef9c3; padding: 15px; border-radius: 8px; border: 1px dashed #ca8a04; text-align: left; box-sizing: border-box;">
      <span style="display: block; font-size: 11px; color: #854d0e; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.3px;">Fator de Rendimento Interno</span>
      <strong style="font-size: 1.2em; color: #1e293b;">
        <%= number_with_precision(@insumo.media_unidades_kg, precision: 1, separator: ",") %> 
        <span style="font-size: 13px; color: #475569; font-weight: normal;">porções ou fatias por unidade de estoque</span>
      </strong>
    </div>

    <%# 🌟 ATUALIZADO: PAINEL DE MONITORAMENTO DE SALDO REAL VS ALERTA MÍNIMO %>
    <div style="text-align: left; margin-top: 10px; box-sizing: border-box;">
      <h3 style="color: #D71920; font-weight: bold; font-size: 12px; margin-bottom: 15px; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Níveis de Estoque por Unidade</h3>
      
      <%
        saldo_c  = @insumo.respond_to?(:saldo_centro) ? @insumo.saldo_centro.to_f : 0.0
        saldo_pn = @insumo.respond_to?(:saldo_pavilhao_novo) ? @insumo.saldo_pavilhao_novo.to_f : 0.0
        saldo_pa = @insumo.respond_to?(:saldo_pavilhao_antigo) ? @insumo.saldo_pavilhao_antigo.to_f : 0.0

        alerta_c  = saldo_c < @insumo.estoque_centro.to_f
        alerta_pn = saldo_pn < @insumo.estoque_pavilhao_novo.to_f
        alerta_pa = saldo_pa < @insumo.estoque_pavilhao_antigo.to_f

        precisao = ['kg', 'l'].include?(@insumo.unidade_medida.to_s.downcase) ? 3 : 0
        uni_txt = @insumo.unidade_medida.to_s.downcase
      %>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; width: 100%; box-sizing: border-box;">
        
        <%# MATRIZ CENTRO %>
        <div style="background-color: <%= alerta_c ? '#fef2f2' : '#e0f2fe' %>; padding: 15px 12px; border-radius: 8px; border: 1px solid <%= alerta_c ? '#fee2e2' : '#bae6fd' %>; text-align: center; border-left: 4px solid <%= alerta_c ? '#dc2626' : '#0284c7' %>;">
          <span style="color: #475569; font-weight: bold; display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 2px;">Matriz</span>
          <strong style="font-size: 1.4em; color: <%= alerta_c ? '#dc2626' : '#1e293b' %>; display: block;">
            <%= number_with_precision(saldo_c, precision: precisao, separator: ",") %> <span style="font-size: 10px; font-weight: normal; color: #64748b;"><%= uni_txt %></span>
          </strong>
          <small style="color: #64748b; font-size: 9px; display: block; margin-top: 4px; font-weight: 500;">
            Mín: <%= number_with_precision(@insumo.estoque_centro.to_f, precision: precisao, separator: ",") %>
          </small>
        </div>

        <%# PAVILHÃO NOVO %>
        <div style="background-color: <%= alerta_pn ? '#fef2f2' : '#e0f2fe' %>; padding: 15px 12px; border-radius: 8px; border: 1px solid <%= alerta_pn ? '#fee2e2' : '#bae6fd' %>; text-align: center; border-left: 4px solid <%= alerta_pn ? '#dc2626' : '#0284c7' %>;">
          <span style="color: #475569; font-weight: bold; display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 2px;">Pav. Novo</span>
          <strong style="font-size: 1.4em; color: <%= alerta_pn ? '#dc2626' : '#1e293b' %>; display: block;">
            <%= number_with_precision(saldo_pn, precision: precisao, separator: ",") %> <span style="font-size: 10px; font-weight: normal; color: #64748b;"><%= uni_txt %></span>
          </strong>
          <small style="color: #64748b; font-size: 9px; display: block; margin-top: 4px; font-weight: 500;">
            Mín: <%= number_with_precision(@insumo.estoque_pavilhao_novo.to_f, precision: precisao, separator: ",") %>
          </small>
        </div>

        <%# PAVILHÃO ANTIGO %>
        <div style="background-color: <%= alerta_pa ? '#fef2f2' : '#e0f2fe' %>; padding: 15px 12px; border-radius: 8px; border: 1px solid <%= alerta_pa ? '#fee2e2' : '#bae6fd' %>; text-align: center; border-left: 4px solid <%= alerta_pa ? '#dc2626' : '#0284c7' %>;">
          <span style="color: #475569; font-weight: bold; display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 2px;">Pav. Antigo</span>
          <strong style="font-size: 1.4em; color: <%= alerta_pa ? '#dc2626' : '#1e293b' %>; display: block;">
            <%= number_with_precision(saldo_pa, precision: precisao, separator: ",") %> <span style="font-size: 10px; font-weight: normal; color: #64748b;"><%= uni_txt %></span>
          </strong>
          <small style="color: #64748b; font-size: 9px; display: block; margin-top: 4px; font-weight: 500;">
            Mín: <%= number_with_precision(@insumo.estoque_pavilhao_antigo.to_f, precision: precisao, separator: ",") %>
          </small>
        </div>
      </div>
    </div>

  </div>

  <%# BOTÕES DE AÇÃO: EDITAR + EXCLUIR INSUMO %>
<% if current_funcionario.admin? %>
  <div style="display: flex; gap: 15px; justify-content: center; align-items: stretch; border-top: 1px solid #f1f5f9; padding-top: 25px; margin-top: 20px; width: 100%;">
    
    <%= link_to 'EDITAR INSUMO', edit_insumo_path(@insumo), 
        style: "flex: 1; background-color: #D71920; color: white; padding: 14px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 13px; text-align: center; text-transform: uppercase; display: flex; align-items: center; justify-content: center;" %>

    <%= botao_excluir insumo_path(@insumo), 
        texto: 'EXCLUIR INSUMO', 
        mensagem: "Tem certeza que deseja excluir o insumo #{@insumo.nome}?",
        estilo: "flex: 1; background: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; padding: 14px 25px; border-radius: 8px; font-weight: bold; font-size: 13px; text-transform: uppercase; text-align: center; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;" %>
  </div>
<% end %>

</div>