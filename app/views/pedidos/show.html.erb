<div style="max-width: 500px; margin: 40px auto;">
  <%= render @pedido %>
</div>

<div style="max-width: 500px; margin: 20px auto; display: flex; gap: 15px; align-items: center; flex-wrap: wrap; justify-content: center; font-family: sans-serif;">
  
  <%# 1. BOTÃO DE IMPRESSÃO %>
  <%= link_to comprovante_pedido_path(@pedido), target: "_blank", 
      style: "background-color: #333; color: white; padding: 12px 25px; text-decoration: none; border-radius: 8px; font-weight: bold; display: flex; align-items: center; gap: 10px;" do %>
    <span>Imprimir Cupom</span>
  <% end %>

  <%# 2. BOTÃO DE EDIÇÃO %>
  <button onclick="autorizarAcao('editar')" 
          style="background: none; border: none; color: #0000FF; text-decoration: underline; cursor: pointer; font-family: inherit; font-size: 1em;">
    Editar este pedido
  </button>

  <%= link_to "Voltar aos pedidos", pedidos_path, style: "color: #0000FF; text-decoration: underline;" %>
</div>

<div style="max-width: 500px; margin: 30px auto; padding-top: 20px; border-top: 1px solid #eee; text-align: center; font-family: sans-serif;">
  <%# 3. BOTÃO DE CANCELAMENTO %>
  <button onclick="autorizarAcao('cancelar')" 
          style="background: none; border: none; color: #d9534f; cursor: pointer; text-decoration: underline; font-size: 0.9em;">
       Cancelar este pedido
  </button>
</div>

<%# --- SCRIPT DE SEGURANÇA ATUALIZADO (VALIDAÇÃO DINÂMICA VIA BANCO DE DADOS) --- %>
<script>
document.addEventListener("turbo:load", function() {
  
  // FUNÇÃO GLOBAL: Centraliza a chamada de API de segurança que pode ser reutilizada
  window.solicitarAutorizacaoGerente = function(onSucesso) {
    const ehAdmin = <%= current_funcionario&.admin? || false %>;

    // Se o funcionário logado já for Administrador, o sistema libera a ação imediatamente
    if (ehAdmin) {
      onSucesso();
    } else {
      const codigo = prompt("ESTA AÇÃO REQUER AUTORIZAÇÃO DO GERENTE.\nDigite o seu código de segurança:");
      
      if (codigo) {
        // Dispara a requisição AJAX em segundo plano para a rota global segura do Rails
        fetch("/autorizar_gerente", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute('content')
          },
          body: JSON.stringify({ codigo: codigo })
        })
        .then(response => response.json())
        .then(data => {
          if (data.autorizado) {
            onSucesso(); // Executa o bloco de código protegido (Callback)
          } else {
            alert("Código Inválido ou Usuário não é Administrador! Ação cancelada.");
          }
        })
        .catch(() => alert("Erro ao processar a validação de segurança remota."));
      }
    }
  };

  // Controla o clique dos botões da tela utilizando o validador dinâmico
  window.autorizarAcao = function(acao) {
    if (acao === 'editar') {
      solicitarAutorizacaoGerente(function() {
        window.location.href = "<%= edit_pedido_path(@pedido) %>";
      });
    } else if (acao === 'cancelar') {
      solicitarAutorizacaoGerente(function() {
        if (confirm("Deseja realmente CANCELAR o Pedido #<%= @pedido.id %>?\nEsta ação não pode ser desfeita.")) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = "<%= pedido_path(@pedido) %>";
          
          const methodInput = document.createElement('input');
          methodInput.type = 'hidden';
          methodInput.name = '_method';
          methodInput.value = 'delete';
          
          const tokenInput = document.createElement('input');
          tokenInput.type = 'hidden';
          tokenInput.name = 'authenticity_token';
          tokenInput.value = "<%= form_authenticity_token %>";
          
          form.appendChild(methodInput);
          form.appendChild(tokenInput);
          document.body.appendChild(form);
          form.submit();
        }
      });
    }
  };

});
</script>