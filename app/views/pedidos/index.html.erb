<div class="card-principal" style="max-width: 98%; margin: 40px auto; text-align: center;">
  <h1 style="color: var(--vermelho-quero); margin-bottom: 30px;">Histórico de Pedidos</h1>

  <%# BARRA DE PESQUISA PARA PEDIDOS (JS) %>
  <div style="margin-bottom: 20px; text-align: center;">
    <input type="text" id="buscaPedidos" onkeyup="filtrarPedidos()" placeholder="🔍 Pesquisar por lanche ou local (Centro, Pavilhão...)" 
           style="width: 80%; padding: 12px; border-radius: 20px; border: 1px solid #007bff; outline: none; font-size: 16px;">
  </div>

  <div style="margin-top: 10px; margin-bottom: 30px; text-align: center;">
    <%= link_to "Anotar Novo Pedido", new_pedido_path, 
        style: "background-color: #D71920; color: white; padding: 15px 40px; border-radius: 30px; text-decoration: none; font-weight: bold; font-size: 1.1em; display: inline-block; box-shadow: 0 4px 8px rgba(215, 25, 32, 0.3);" %>
  </div>

  <table style="width: 100%; border-collapse: collapse; margin-top: 20px; table-layout: fixed;">
    <thead>
      <tr style="background-color: #D71920; color: white;">
        <th style="padding: 12px; text-align: left; width: 14%;">Identificação</th>
        <th style="padding: 12px; text-align: left; width: 13%;">Data / Hora</th>
        <th style="padding: 12px; text-align: left; width: 26%;">Produtos / Detalhes</th>
        <th style="padding: 12px; text-align: center; width: 11%;">Qtd Total</th>
        <th style="padding: 12px; text-align: right; width: 12%;">Total do Pedido</th>
        <th style="padding: 12px; text-align: center; width: 10%;">Pagamento</th>
        <th style="padding: 12px; text-align: center; width: 10%;">Local</th>
        <th style="padding: 12px; text-align: center; width: 14%;">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @pedidos.each do |pedido| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <strong><%= pedido.cliente_nome.presence || "Não identificado" %></strong>
          </td>
          
          <td style="padding: 12px; text-align: left; color: #666; font-size: 0.95em;">
            <%= pedido.created_at.strftime("%d/%m/%Y %H:%M") %>
          </td>

          <td style="padding: 12px; text-align: left; font-size: 0.95em;">
            <% if pedido.item_pedidos.any? %>
              <ul style="margin: 0; padding-left: 20px; list-style-type: square;">
                <% pedido.item_pedidos.each do |item| %>
                  <% 
                    # Mapeia o fator multiplicador do preço com base no tamanho/peso selecionado
                    fator = case item.tamanho.to_s.strip
                            when "Copo 200ml"                 then 0.2
                            when "Copo 300ml"                 then 0.3
                            when "Copo 500ml"                 then 0.5
                            when "Copo 700ml"                 then 0.7
                            when "Jarra 1L", "Padrão"         then 1.0
                            when "Porção 300g"                then 0.3
                            when "Porção 500g"                then 0.5
                            when "Por Peso / Balança (KG)"    then 1.0
                            else 1.0
                            end

                    preco_un = ((item.produto&.preco_venda.to_f) * fator).round(2)
                    
                    # Se for por peso livre, aceitamos casas decimais na quantidade (ex: 0,450 kg), caso contrário mostra inteiro
                    es_por_peso = item.tamanho.to_s.include?("Balança") || item.tamanho.to_s.include?("(KG)")
                    qtd_exibida = es_por_peso ? sprintf("%.3f", item.quantidade.to_f).gsub('.', ',') : item.quantidade.to_i.to_s
                    unidade_texto = es_por_peso ? " kg" : "x"
                  %>
                  
                  <li>
                    <%= item.produto&.nome %> 
                    <%= "(#{item.tamanho})" if item.tamanho.present? %> 
                    - <span style="color: #666;">
                      <%= es_por_peso ? "#{qtd_exibida}#{unidade_texto}" : "#{qtd_exibida} #{unidade_texto}" %> de <%= number_to_currency(preco_un, unit: "R$ ") %>
                    </span>
                  </li>
                <% end %> <%# CORRETO: O loop fecha aqui, DEPOIS de renderizar a tag <li> %>
              </ul>
            <% else %>
              <%= pedido.respond_to?(:produto) && pedido.produto ? pedido.produto.nome : "Produto não registrado" %>
              <span style="color: #666;">(Histórico legado)</span>
            <% end %>
          </td>

          <td style="padding: 12px; text-align: center; color: #666;">
            <% 
              total_qtd = pedido.item_pedidos.any? ? pedido.item_pedidos.sum(:quantidade).to_i : (pedido.respond_to?(:quantidade) ? pedido.quantidade.to_i : 1)
            %>
            <%= total_qtd %> <%= total_qtd == 1 ? "unidade" : "unidades" %>
          </td>
          
          <td style="padding: 12px; text-align: right; font-weight: bold; color: #28a745;">
            <%= number_to_currency(pedido.valor_total, unit: "R$ ", separator: ",", delimiter: ".") %>
          </td>

          <td style="padding: 12px; text-align: center; font-size: 0.95em; color: #444;">
            <% formas = [] %>
            <% formas << "Dinheiro" if pedido.pago_dinheiro.present? && pedido.pago_dinheiro > 0 %>
            <% formas << "Pix" if pedido.pago_pix.present? && pedido.pago_pix > 0 %>
            <% formas << "Débito" if pedido.pago_cartao_debito.present? && pedido.pago_cartao_debito > 0 %>
            <% formas << "Crédito" if pedido.pago_cartao_credito.present? && pedido.pago_cartao_credito > 0 %>
            
            <%= formas.any? ? formas.join(" + ") : "<span style='color: #999; font-style: italic;'>Não informado</span>".html_safe %>
          </td>
          
          <td style="padding: 12px; text-align: center;"><%= pedido.unidade %></td>
          
          <td style="padding: 12px; text-align: center; white-space: nowrap;">
            <%= link_to 'Detalhes', pedido_path(pedido), 
             style: "color: #0000FF; text-decoration: underline; margin-right: 12px; font-family: sans-serif; font-weight: 500;" %>

            <% if current_funcionario.admin? %>
              <%= link_to 'Editar', edit_pedido_path(pedido), 
               style: "color: #0000FF; text-decoration: underline; font-family: sans-serif; font-weight: 500;" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
function filtrarPedidos() {
  var input = document.getElementById("buscaPedidos");
  var filter = input.value.toUpperCase();
  var table = document.querySelector("table");
  var tr = table.getElementsByTagName("tr");

  for (var i = 1; i < tr.length; i++) {
    var tdProduto = tr[i].getElementsByTagName("td")[2]; 
    var tdLocal = tr[i].getElementsByTagName("td")[6];   
    
    if (tdProduto || tdLocal) {
      var txtProduto = tdProduto ? (tdProduto.textContent || tdProduto.innerText) : "";
      var txtLocal = tdLocal ? (tdLocal.textContent || tdLocal.innerText) : "";
      
      if (txtProduto.toUpperCase().indexOf(filter) > -1 || txtLocal.toUpperCase().indexOf(filter) > -1) {
        tr[i].style.display = "";
      } else {
        tr[i].style.display = "none";
      }
    }
  }
}
</script>