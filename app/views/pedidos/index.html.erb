<div style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: sans-serif; box-sizing: border-box; text-align: center;">
  
  <%# BOTÃO DE RETORNO SUPERIOR %>
  <div style="margin-bottom: 25px; text-align: left;" class="no-print">
    <%= link_to root_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;" do %>
      ← VOLTAR PARA O PAINEL 
    <% end %>
  </div>

  <%# CONTÊINER PRINCIPAL MOLDURA VERMELHA %>
  <div class="card-principal" style="padding: 35px; background: #fff; border-radius: 12px; border: 2px solid #D71920 !important; box-shadow: 0 4px 15px rgba(0,0,0,0.06); box-sizing: border-box;">
    
    <h1 style="color: #D71920; margin-top: 0; margin-bottom: 25px; font-size: 2em; font-weight: bold; letter-spacing: 0.5px;">
      Histórico de Pedidos
    </h1>

    <%# BARRA DE PESQUISA ARREDONDADA %>
    <div style="margin-bottom: 25px; text-align: center; box-sizing: border-box;">
      <input type="text" id="buscaPedidos" onkeyup="filtrarPedidos()" placeholder="🔍 Pesquisar por lanche, cliente ou local (Centro, Pavilhão...)" 
             style="width: 100%; max-width: 500px; padding: 12px 20px; border-radius: 30px; border: 1px solid #cbd5e1; outline: none; font-size: 15px; color: #1a202c; font-weight: 500; transition: border-color 0.2s; box-sizing: border-box;"
             onfocus="this.style.borderColor='#D71920'" onblur="this.style.borderColor='#cbd5e1'">
    </div>

    <%# CADASTRAR NOVO PEDIDO - ALINHAMENTO BLINDADO À DIREITA %>
    <div style="margin-bottom: 25px; text-align: right; box-sizing: border-box; width: 100%;">
      <%= link_to new_pedido_path, 
          style: "background-color: #D71920; color: white; padding: 10px 22px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 12px; display: inline-block; box-shadow: 0 4px 10px rgba(215, 25, 32, 0.18); text-transform: uppercase; letter-spacing: 0.5px;" do %>
        + ANOTAR NOVO PEDIDO
      <% end %>
    </div>

    <%# LISTAGEM EM FILAS DE LINHAS COMPACTAS %>
    <div id="lista-historico-container" style="display: flex; flex-direction: column; gap: 15px; box-sizing: border-box;">
      <% @pedidos.each do |pedido| %>
        <div class="linha-pedido-card" style="border: 1px solid #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 12px; background: #fff; text-align: left; box-sizing: border-box; transition: background 0.2s;" onmouseover="this.style.borderColor='#D71920'" onmouseout="this.style.borderColor='#cbd5e1'">
          
          <%# CABEÇALHO DO CARD %>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px dashed #cbd5e1; padding-bottom: 10px; box-sizing: border-box;">
            <div>
              <span style="color: #4a5568; font-size: 0.85em; display: block; font-weight: bold;">Pedido #<%= pedido.id %></span>
              <strong style="font-size: 1.15em; color: #1a202c; text-transform: uppercase;"><%= pedido.cliente_nome.presence || "CONSUMIDOR FINAL" %></strong>
            </div>
            <div style="text-align: right; box-sizing: border-box;">
              <span style="color: #2d3748; font-size: 0.9em; display: block; font-weight: bold;"><%= pedido.created_at.strftime("%d/%m/%Y %H:%M") %></span>
              <span style="font-size: 0.85em; background: #fef2f2; color: #b91c1c; padding: 3px 10px; border-radius: 12px; font-weight: bold; display: inline-block; margin-top: 4px; border: 1px solid #fee2e2; text-transform: uppercase; letter-spacing: 0.3px;">
                 <%= pedido.unidade&.nome&.gsub('_', ' ') %>
              </span>
            </div>
          </div>

          <%# CONTEÚDO / PRODUTOS %>
          <div style="font-size: 0.95em; color: #1a202c; box-sizing: border-box;">
            <% if pedido.item_pedidos.any? %>
              <ul style="margin: 0; padding-left: 15px; list-style-type: square; color: #1a202c;">
                <% pedido.item_pedidos.each do |item| %>
                  <% 
                    preco_un = item.preco_unitario.to_f > 0 ? item.preco_unitario.to_f : item.produto&.preco_venda.to_f
                    es_por_peso = item.tamanho.to_s.downcase.include?("balança") || item.tamanho.to_s.downcase.include?("kg")
                    qtd_exibida = es_por_peso ? number_with_precision(item.quantidade, precision: 3, separator: ",") : item.quantidade.to_i.to_s
                    unidade_texto = es_por_peso ? " kg" : "x"
                  %>
                  <li style="margin-bottom: 6px; line-height: 1.4;">
                    <strong style="color: #1a202c; text-transform: uppercase;"><%= item.produto&.nome %></strong>
                    <%= "<span style='color: #D71920; font-weight: bold;'>[#{item.tamanho}]</span>".html_safe if item.tamanho.present? %> 
                    <span style="color: #2d3748; font-weight: 500;">
                      - <%= es_por_peso ? "#{qtd_exibida}#{unidade_texto}" : "#{qtd_exibida} #{unidade_texto}" %> de <%= number_to_currency(preco_un, unit: "R$ ") %>
                    </span>

                    <% if item.item_pedido_adicionais.any? %>
                      <ul style="margin: 4px 0 0 0; padding: 4px 8px; list-style: none; font-size: 0.9em; color: #155724; background: #f0fdf4; border-radius: 4px; border: 1px solid #d1fae5; display: inline-block;">
                        <% item.item_pedido_adicionais.each do |add| %>
                          <li>
                             Extra: <%= add.quantidade.to_i %>x <%= add.insumo&.nome&.upcase %> 
                            (+ <%= number_to_currency(add.preco_unitario.to_f * add.quantidade.to_f, unit: "R$ ") %>)
                          </li>
                        <% end %>
                      </ul>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <span style="color: #2d3748; font-weight: bold;"><%= pedido.respond_to?(:produto) && pedido.produto ? pedido.produto.nome.upcase : "Produto não registrado" %> (Legado)</span>
            <% end %>
          </div>

          <%# RODAPÉ DO CARD %>
          <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 10px 14px; border-radius: 8px; margin-top: 4px; border: 1px solid #e2e8f0; box-sizing: border-box;">
            <div>
              <strong style="color: #4a5568; font-size: 0.9em;">Forma: </strong>
              <span style="font-size: 0.9em; font-weight: bold; color: #1a202c;">
                <% formas = [] %>
                <% formas << "Dinheiro" if pedido.pago_dinheiro.to_f > 0 %>
                <% formas << "Pix" if pedido.pago_pix.to_f > 0 %>
                <% formas << "Débito" if pedido.pago_cartao_debito.to_f > 0 %>
                <% formas << "Crédito" if pedido.pago_cartao_credito.to_f > 0 %>
                <%= formas.any? ? formas.join(" + ") : "Não informado" %>
              </span>
            </div>
            
            <div style="display: flex; align-items: center; gap: 15px; box-sizing: border-box;">
              <div>
                <span style="color: #16a34a; font-weight: bold; font-size: 1.2em;">
                  <%= number_to_currency(pedido.valor_total, unit: "R$ ") %>
                </span>
              </div>
              
              <%= link_to pedido_path(pedido), style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.3px;" do %>
                Detalhes
              <% end %>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
function filtrarPedidos() {
  var input = document.getElementById("buscaPedidos");
  var filter = input.value.toUpperCase();
  var container = document.getElementById("lista-historico-container");
  var cards = container.getElementsByClassName("linha-pedido-card");

  for (var i = 0; i < cards.length; i++) {
    var textoCard = cards[i].textContent || cards[i].innerText;
    if (textoCard.toUpperCase().indexOf(filter) > -1) {
      cards[i].style.display = "";
    } else {
      cards[i].style.display = "none";
    }
  }
}
</script>