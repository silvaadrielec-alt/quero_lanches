<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: 'Courier New', Courier, monospace; width: 75mm; margin: 0; padding: 10px; font-size: 12px; line-height: 1.3; color: #000; }
    .text-center { text-align: center; }
    .linha { border-top: 1px dashed #000; margin: 6px 0; }
    .flex { display: flex; justify-content: space-between; }
    .total { font-weight: bold; font-size: 14px; margin-top: 6px; }
    .obs-box { background: #f5f5f5; padding: 6px; margin: 10px 0; border: 1px solid #000; font-style: italic; }
    .adicional-comprovante { font-size: 11px; padding-left: 10px; }
    @media print { .btn-print { display: none; } }
  </style>
</head>
<body onload="window.print()">
  <div class="text-center">
    <h2 style="margin: 0; font-size: 16px; font-weight: bold;">QUERO LANCHES</h2>
    <p style="margin: 2px 0;"><%= @pedido.unidade&.nome&.gsub('_', ' ')&.upcase %></p>
    <p style="margin: 0;"><%= @pedido.created_at.strftime("%d/%m/%Y %H:%M") %></p>
  </div>

  <div class="linha"></div>
  <div class="text-center"><strong>PEDIDO #<%= @pedido.id %></strong></div>
  <div class="linha"></div>

  <div style="margin: 8px 0;">
    <strong>Cliente:</strong> <%= @pedido.cliente_nome.presence || "Não identificado" %>
  </div>

  <div class="flex" style="font-weight: bold; border-bottom: 1px dashed #000; padding-bottom: 4px; margin-bottom: 6px;">
    <span>Item / Detalhes</span>
    <span>Valor</span>
  </div>

  <% if @pedido.item_pedidos.any? %>
    <% @pedido.item_pedidos.each do |item| %>
      <% 
        preco_un = item.respond_to?(:preco_unitario) && item.preco_unitario.to_f > 0 ? item.preco_unitario.to_f : item.produto&.preco_venda.to_f
        total_item = preco_un * item.quantidade.to_f
      %>
      <div style="margin-bottom: 6px; border-bottom: 1px dotted #ccc; padding-bottom: 4px;">
        <div class="flex" style="font-weight: bold;">
          <span><%= item.produto&.nome %> (x<%= item.quantidade.to_i %>)</span>
          <span>R$ <%= number_with_precision(total_item, precision: 2) %></span>
        </div>
        <% if item.tamanho.present? %>
          <div style="font-size: 11px; color: #444; padding-left: 5px;">
            Tamanho: <%= item.tamanho %>
          </div>
        <% end %>

        <% if item.item_pedido_adicionais.any? %>
          <% item.item_pedido_adicionais.each do |add| %>
            <div class="flex adicional-comprovante">
              <span>+ Extra: <%= add.quantidade.to_i %>x <%= add.insumo&.nome&.upcase %></span>
              <span>R$ <%= number_with_precision(add.preco_unitario.to_f * add.quantidade.to_f, precision: 2) %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="flex">
      <span><%= @pedido.respond_to?(:produto) && @pedido.produto ? @pedido.produto.nome : "Produto legado" %> (x<%= @pedido.respond_to?(:quantidade) ? @pedido.quantidade : 1 %>)</span>
      <span>R$ <%= number_with_precision(@pedido.valor_total, precision: 2) %></span>
    </div>
  <% end %>

  <% if @pedido.observacao.present? %>
    <div class="obs-box">
      <strong>Obs:</strong> <%= @pedido.observacao %>
    </div>
  <% end %>

  <div class="linha"></div>
  
  <div class="flex total">
    <span>TOTAL REAL DO PEDIDO:</span>
    <span>R$ <%= number_with_precision(@pedido.valor_total, precision: 2) %></span>
  </div>

  <div style="margin-top: 10px; font-size: 11px;">
    <strong>Resumo do Recebimento:</strong><br>
    
    <% d = @pedido.pago_dinheiro.to_f %>
    <% p = @pedido.pago_pix.to_f %>
    <% deb = @pedido.pago_cartao_debito.to_f %>
    <% cre = @pedido.pago_cartao_credito.to_f %>
    <% total_recebido = d + p + deb + cre %>

    <% if d > 0 %> <div class="flex"><span>- Dinheiro:</span><span>R$ <%= number_with_precision(d, precision: 2) %></span></div> <% end %>
    <% if p > 0 %> <div class="flex"><span>- Pix:</span><span>R$ <%= number_with_precision(p, precision: 2) %></span></div> <% end %>
    <% if deb > 0 %> <div class="flex"><span>- Débito:</span><span>R$ <%= number_with_precision(deb, precision: 2) %></span></div> <% end %>
    <% if cre > 0 %> <div class="flex"><span>- Crédito:</span><span>R$ <%= number_with_precision(cre, precision: 2) %></span></div> <% end %>
  </div>

  <% if total_recebido > @pedido.valor_total %>
    <div class="flex" style="margin-top: 5px; font-weight: bold; border-top: 1px dashed #000; padding-top: 5px;">
      <span>TROCO EM DINHEIRO:</span>
      <span>R$ <%= number_with_precision(total_recebido - @pedido.valor_total, precision: 2) %></span>
    </div>
  <% end %>

  <div class="linha"></div>

  <div class="text-center" style="margin-top: 12px; font-size: 10px;">
    Atendente: <%= @pedido.funcionario&.nome %><br>
    Posto: <%= @pedido.unidade&.nome&.upcase %><br>
    --- OBRIGADO E VOLTE SEMPRE ---
  </div>

  <div class="text-center btn-print" style="margin-top: 20px;">
    <button onclick="window.close()" style="padding: 8px 15px; cursor: pointer; border-radius: 4px; font-weight: bold; border: 1px solid #000; background: #fff;">Fechar Janela</button>
  </div>
</body>
</html>