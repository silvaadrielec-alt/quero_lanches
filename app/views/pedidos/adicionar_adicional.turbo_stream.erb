<%= turbo_stream.append "container-adicionais-linhas-#{@index_item}" do %>
  <%= fields_for "pedido[item_pedidos_attributes][#{@index_item}][item_pedido_adicionais_attributes][#{@index_adicional}]", @adicional do |add_form| %>
    
    <div class="adicional-linha-sub" style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px; box-sizing: border-box; text-align: left;">
      <input type="text" 
             list="lista-adicionais-venda" 
             class="input-busca-adicional" 
             placeholder="Selecione o Extra..." 
             style="flex: 2; padding: 6px 12px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; height: 34px; box-sizing: border-box; color: #1e293b;">
      
      <%= add_form.hidden_field :insumo_id, class: "select-adicional-id" %>
      <%= add_form.hidden_field :preco_unitario, class: "input-preco-add-oculto", value: "0.00" %>
      
      <div style="display: flex; align-items: center; gap: 6px; box-sizing: border-box;">
        <span style="font-size: 12px; color: #475569; font-family: sans-serif; font-weight: bold;">Qtd:</span>
        <%= add_form.number_field :quantidade, class: "input-qtd-adicional", value: 1, min: 1, style: "width: 55px; padding: 6px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; text-align: center; height: 34px; box-sizing: border-box; color: #1e293b;" %>
      </div>
      
      <button type="button" onclick="this.closest('.adicional-linha-sub').remove(); calcularTudo();" style="background: none; color: #dc2626; border: none; font-weight: bold; cursor: pointer; font-size: 1.2em; padding: 0 5px; height: 34px; display: flex; align-items: center;">✕</button>
    </div>

  <% end %>
<% end %>

<script>
  // Apenas força o recálculo do totalizador geral para incluir a nova linha zerada
  calcularTudo();
</script>