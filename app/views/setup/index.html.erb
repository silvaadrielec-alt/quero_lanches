<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background-color: #fdf8f5; font-family: sans-serif; box-sizing: border-box; padding: 20px;">
  
  <%# CARD DE CONFIGURAÇÃO INICIAL COM A MOLDURA VERMELHA OFICIAL %>
  <div class="card-principal" style="background: white; padding: 45px 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); width: 100%; max-width: 480px; border: 2px solid #D71920 !important; text-align: center; box-sizing: border-box;">
    
    <%# CABEÇALHO DA TELA %>
    <div style="margin-bottom: 30px;">
      <span style="background: #FFF0F0; color: #D71920; padding: 6px 14px; border-radius: 6px; font-size: 11px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase; border: 1px solid #FFDCDC;">
        Instalação do Sistema
      </span>
      <h2 style="color: #D71920; font-weight: bold; margin: 12px 0 6px 0; font-size: 2em; letter-spacing: 0.5px;">CONFIGURAÇÃO INICIAL</h2>
      <p style="color: #475569; font-size: 14px; line-height: 1.5; margin: 0;">
        Bem-vindo ao sistema! Identificamos que este é o <strong>primeiro acesso</strong>.<br>
        Cadastre o Administrador Geral para começar a gerenciar a Quero Lanches.
      </p>
    </div>

    <%= form_with model: Funcionario.new, url: criar_primeiro_admin_path, local: true do |f| %>
      
      <%# EXIBIÇÃO DE ERROS NO PADRÃO TONAL PREMIUM %>
      <% if f.object.errors.any? %>
        <div style="color: #dc2626; background: #fef2f2; padding: 18px; border-radius: 8px; margin-bottom: 25px; border: 1px solid #fee2e2; text-align: left; box-sizing: border-box; font-size: 14px;">
          <strong style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.3px;">Ops! Verifique os erros abaixo:</strong>
          <ul style="margin: 8px 0 0 0; padding-left: 20px; color: #b91c1c; line-height: 1.4;">
            <% f.object.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# CAMPO: NOME %>
      <div style="text-align: left; margin-bottom: 20px; display: flex; flex-direction: column;">
        <%= f.label :nome, "Nome do Administrador", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.text_field :nome, placeholder: "Ex: Davi Quero Lanches", required: true, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; color: #1e293b; font-weight: 500;" %>
      </div>

      <%# CAMPO: E-MAIL %>
      <div style="text-align: left; margin-bottom: 20px; display: flex; flex-direction: column;">
        <%= f.label :email, "E-mail de Login", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.email_field :email, placeholder: "admin@querolanches.com", required: true, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; color: #1e293b; font-weight: 500;" %>
      </div>

      <%# CAMPO: PIN / CÓDIGO DE AUTORIZAÇÃO %>
      <div style="text-align: left; margin-bottom: 20px; display: flex; flex-direction: column;">
        <%= f.label :codigo_autorizacao, "Código de Autorização (PIN para operações críticas)", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.text_field :codigo_autorizacao, placeholder: "Ex: 1234", maxlength: 6, required: true, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; font-weight: bold; color: #1e293b;" %>
      </div>
       
      <%# GRID DE SENHAS COMPACTO %>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; text-align: left; margin-bottom: 30px; box-sizing: border-box;">
        <div style="display: flex; flex-direction: column;">
          <%= f.label :password, "Defina uma Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase;" %>
          <%= f.password_field :password, placeholder: "Senha forte", required: true, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px;" %>
        </div>

        <div style="display: flex; flex-direction: column;">
          <%= f.label :password_confirmation, "Confirme a Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase;" %>
          <%= f.password_field :password_confirmation, placeholder: "Repita a senha", required: true, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px;" %>
        </div>
      </div>

      <%# BOTÃO DE SUBMIT VERMELHO CORPORATIVO %>
      <div>
        <%= f.submit "FINALIZAR E ENTRAR", style: "width: 100%; background: #D71920; color: white; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box;" %>
      </div>
    <% end %>

    <%# AVISO INFERIOR DE SEGURANÇA %>
    <p style="margin-top: 25px; font-size: 12px; color: #94a3b8; line-height: 1.4; margin-bottom: 0; background: #f8fafc; padding: 12px; border-radius: 6px; border: 1px dashed #cbd5e1;">
      * Este acesso é único. Após o primeiro cadastro, esta tela será desativada permanentemente por questões de segurança.
    </p>
  </div>
</div>