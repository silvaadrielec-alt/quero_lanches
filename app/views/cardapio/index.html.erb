<div class="card-principal" style="max-width: 1100px; margin: 40px auto; text-align: center; font-family: sans-serif;">
  <h1 style="color: var(--vermelho-quero); margin-bottom: 30px; font-weight: bold;">Cardápio de Vendas</h1>

  <%# BARRA DE PESQUISA %>
  <div style="margin-bottom: 20px;">
    <input type="text" id="buscaCardapio" onkeyup="filtrarCardapio()" placeholder="🔍 Pesquisar lanche..." 
           style="width: 80%; padding: 12px; border-radius: 20px; border: 1px solid #007bff; outline: none; font-size: 1em;">
  </div>

  <% if current_funcionario.admin? %>
    <div style="margin-top: -10px; margin-bottom: 30px;">
      <%= link_to "Cadastrar Novo Item no Cardápio", new_cardapio_path, 
          style: "background-color: #D71920; color: white; padding: 12px 25px; border-radius: 25px; text-decoration: none; font-weight: bold; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" %>
    </div>
  <% end %>

  <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
    <thead>
      <tr style="background: #D71920; color: white;">
        <th style="padding: 15px; text-align: left; padding-left: 30px;">LANCHE / BEBIDA</th>
        <th style="padding: 15px; text-align: center;">PREÇO</th>
        <th style="padding: 15px; text-align: center;">AÇÕES</th>
      </tr>
    </thead>
    <tbody>
      <% @produtos.each do |produto| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 15px; text-align: left; padding-left: 30px;">
            <strong style="font-size: 1.1em; color: #333;"><%= produto.nome %></strong>
          </td>
          <td style="padding: 15px; text-align: center; font-weight: bold; color: #28a745;">
            <%= number_to_currency(produto.preco_venda) %>
          </td>
          <td style="text-align: center; padding: 15px;">
            <%= link_to 'Detalhes', cardapio_path(produto), style: "color: #0000FF; text-decoration: underline; margin-right: 15px; font-weight: bold;" %>

            <% if current_funcionario.admin? %>
              <%= link_to 'Editar', edit_cardapio_path(produto), style: "color: #0000FF; text-decoration: underline; margin-right: 15px;" %>
              <%= link_to 'Excluir', cardapio_path(produto), data: { turbo_method: :delete, turbo_confirm: 'Tem certeza que deseja excluir este item do cardápio?' }, style: "color: #D71920; text-decoration: underline;" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
function filtrarCardapio() {
  var input = document.getElementById("buscaCardapio").value.toUpperCase();
  var rows = document.querySelector("table tbody").rows;
  for (var i = 0; i < rows.length; i++) {
    var nome = rows[i].cells[0].textContent.toUpperCase();
    rows[i].style.display = nome.includes(input) ? "" : "none";
  }
}
</script>