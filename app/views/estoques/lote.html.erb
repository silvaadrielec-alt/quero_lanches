<%# Links do Tom Select para a busca inteligente nos campos de seleção %>
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<%# CORREÇÃO CSS: Força o Tom Select a ignorar o limite da tabela e ficar por cima de tudo %>
<style>
  /* Garante que a tabela ou as linhas não cortem o menu suspenso */
  #tabela-lote, .linha-item, td {
    overflow: visible !important;
  }
  
  /* Garante que o menu suspenso do Tom Select flutue acima de qualquer outro elemento */
  .ts-dropdown {
    z-index: 9999 !important;
    position: absolute !important;
  }
</style>

<div class="container-estoque" style="max-width: 800px; margin: 0 auto; padding: 20px; font-family: sans-serif;">
  
  <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <%= link_to "← Voltar para Estoque", estoques_path, style: "color: #0000FF; text-decoration: underline; font-weight: bold;" %>
  </div>

  <h2 style="color: #333; font-weight: bold; border-bottom: 2px solid #D71920; padding-bottom: 10px; text-align: left;">
    Nova Entrada de Estoque (Por Lote)
  </h2>
  
  <p style="color: #666; font-size: 0.95em; margin-bottom: 25px; text-align: left;">
    Use esta tela para dar entrada em várias mercadorias de uma só vez (ex: compras com fornecedores). Selecione a unidade de destino e liste os produtos abaixo.
  </p>

  <%= form_with url: processar_lote_estoques_path, method: :post, local: true do |f| %>
    
    <%# --- Caixinha Destacada em Roxo/Lilás Original --- %>
    <div style="background: #f5eef8; padding: 20px; border-radius: 12px; border-left: 6px solid #9b59b6; margin-bottom: 25px; text-align: left;">
      <%= f.label :unidade, "Unidade de Destino (Para onde vão esses produtos?)", style: "display: block; font-weight: bold; color: #7D3C98; margin-bottom: 8px;" %>
      <%= f.select :unidade, [
            ['Matriz Centro', 'centro'],
            ['Pavilhão Novo', 'pavilhao_novo'],
            ['Pavilhão Antigo', 'pavilhao_antigo']
          ], { prompt: "Selecione a unidade de destino..." }, 
          required: true,
          style: "width: 100%; max-width: 400px; padding: 12px; border-radius: 8px; border: 2px solid #9b59b6; font-size: 15px; font-weight: bold;" %>
    </div>

    <%# --- GRADE DE ITENS (O LOTE) --- %>
    <h3 style="color: #333; font-size: 1.1em; font-weight: bold; margin-bottom: 10px; text-align: left;">Itens do Lote</h3>
    
    <table id="tabela-lote" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; text-align: left; overflow: visible !important;">
      <thead>
        <tr style="background: #D71920; color: white;">
          <th style="padding: 12px; width: 65%; border-top-left-radius: 8px;">Produto / Insumo (Digite Nome ou Código)</th>
          <th style="padding: 12px; width: 25%;">Qtd. Entrada</th>
          <th style="padding: 12px; width: 10%; text-align: center; border-top-right-radius: 8px;">Ação</th>
        </tr>
      </thead>
      <tbody>
        <tr class="linha-item" style="border-bottom: 1px solid #eee;">
          <td style="padding: 15px 10px; overflow: visible !important;">
            <select name="itens[0][produto_id]" class="select-busca-inteligente" required style="width: 100%;">
              <option value="">Digite o nome ou código...</option>
              <% @produtos.each do |p| %>
                <option value="<%= p.id %>">
                  <%= p.codigo.present? ? "[#{p.codigo}] #{p.nome}" : p.nome %>
                </option>
              <% end %>
            </select>
          </td>
          <td style="padding: 15px 10px; vertical-align: middle;">
            <%= number_field_tag "itens[0][quantidade]", nil, step: :any, min: 0.01, required: true, placeholder: "0.00", style: "width: 90%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; height: 36px; box-sizing: border-box;" %>
          </td>
          <td style="padding: 15px 10px; text-align: center; vertical-align: middle;">
            <button type="button" class="btn-remover" onclick="removerLinha(this)" style="background: none; border: none; color: #ff4444; font-size: 1.2em; cursor: pointer; display: none;">❌</button>
          </td>
        </tr>
      </tbody>
    </table>

    <%# Botão para Adicionar Nova Linha no Lote %>
    <div style="text-align: left; margin-bottom: 40px;">
      <button type="button" id="btn-adicionar" style="background: #f4f6f7; color: #555; border: 1px solid #ccc; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 0.9em;">
        ➕ Adicionar outro item ao lote
      </button>
    </div>

    <%# --- BOTÃO DE SALVAMENTO FINAL --- %>
    <div style="background: #fafafa; padding: 20px; border-radius: 12px; border-top: 1px solid #eee; text-align: right;">
      <%= f.submit "PROCESSAR ENTRADA DE ESTOQUE", style: "background: #28a745; color: white; border: none; padding: 15px 35px; border-radius: 30px; font-size: 1.1em; font-weight: bold; cursor: pointer; box-shadow: 0 4px 10px rgba(40,167,69,0.2);" %>
    </div>

  <% end %>
</div>

<script>
  function aplicarTomSelect(elemento) {
    if (typeof TomSelect !== "undefined" && !elemento.classList.contains("tomselected")) {
      new TomSelect(elemento, {
        create: false,
        sortField: { field: "text", direction: "asc" },
        placeholder: "Digite o nome ou código...",
        maxOptions: 100,
        dropdownParent: 'body' // CORREÇÃO MASTER: Renderiza o menu no body para descolar da tabela
      });
    }
  }

  function inicializarTelaLote() {
    document.querySelectorAll(".select-busca-inteligente").forEach(function(select) {
      aplicarTomSelect(select);
    });
  }

  document.addEventListener("turbo:load", inicializarTelaLote);
  document.addEventListener("DOMContentLoaded", inicializarTelaLote);
  setTimeout(inicializarTelaLote, 100);

  document.addEventListener("turbo:load", function() {
    const btnAdicionar = document.getElementById("btn-adicionar");
    const tabelaBody = document.querySelector("#tabela-lote tbody");
    
    if (!btnAdicionar || btnAdicionar.dataset.listenerAtivo === "true") return;
    btnAdicionar.dataset.listenerAtivo = "true";

    let contadorItens = document.querySelectorAll(".linha-item").length;

    btnAdicionar.addEventListener("click", function() {
      const novaLinha = document.createElement("tr");
      novaLinha.className = "linha-item";
      novaLinha.style.borderBottom = "1px solid #eee";
      
      const selectOriginal = document.querySelector(".select-busca-inteligente");
      const htmlOpcoes = selectOriginal ? selectOriginal.innerHTML : "";

      novaLinha.innerHTML = `
        <td style="padding: 15px 10px; overflow: visible !important;">
          <select name="itens[${contadorItens}][produto_id]" class="select-busca-inteligente" required style="width: 100%;">
            ${htmlOpcoes}
          </select>
        </td>
        <td style="padding: 15px 10px; vertical-align: middle;">
          <input type="number" name="itens[${contadorItens}][quantidade]" step="any" min="0.01" required="required" placeholder="0.00" style="width: 90%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; height: 36px; box-sizing: border-box;">
        </td>
        <td style="padding: 15px 10px; text-align: center; vertical-align: middle;">
          <button type="button" class="btn-remover" onclick="removerLinha(this)" style="background: none; border: none; color: #ff4444; font-size: 1.2em; cursor: pointer;">❌</button>
        </td>
      `;

      tabelaBody.appendChild(novaLinha);

      const novoSelect = novaLinha.querySelector(".select-busca-inteligente");
      if (novoSelect) {
        aplicarTomSelect(novoSelect);
      }

      contadorItens++;
    });
  });

  function removerLinha(botao) {
    const linha = botao.closest("tr");
    const select = linha.querySelector(".select-busca-inteligente");
    if (select && select.tomselect) {
      select.tomselect.destroy();
    }
    linha.remove();
  }
</script>