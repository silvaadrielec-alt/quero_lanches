<% if notice.present? %>
  <p style="color: #16a34a; font-weight: bold; text-align: center; font-family: sans-serif; font-size: 14px; margin-bottom: 15px;"><%= notice %></p>
<% end %>

<%# BOTÃO EXECUTIVO COMPACTO DE RETORNO NO TOPO %>
<div style="max-width: 550px; margin: 20px auto 15px auto; padding: 0 10px; box-sizing: border-box; text-align: left; font-family: sans-serif;">
  <%= link_to estoques_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;" do %>
    ← CANCELAR E VOLTAR
  <% end %>
</div>

<%# CARD PRINCIPAL DE EDIÇÃO COM A MOLDURA VERMELHA OFICIAL %>
<div class="card-principal" style="max-width: 550px; margin: 0 auto 40px auto; padding: 35px; font-family: sans-serif; background: #fff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); box-sizing: border-box; text-align: center; border: 2px solid #D71920 !important;">
  
  <h1 style="color: #1e293b; font-weight: bold; margin-top: 0; font-size: 1.5em; text-transform: uppercase; letter-spacing: 0.5px;">Ajustar Inventário</h1>
  <h3 style="color: #D71920; margin-bottom: 25px; font-weight: bold; font-size: 1.2em; letter-spacing: 0.5px;"><%= @item.nome.upcase %></h3>

  <%#  PAINEL DE INVENTÁRIO FORENSE %>
  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #475569; padding: 12px 15px; border-radius: 8px; margin-bottom: 25px; text-align: left; box-sizing: border-box;">
    <strong style="color: #1e293b; font-size: 12px; display: block; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 4px;">
        CONTAGEM FÍSICA DE AUDITORIA
    </strong>
    <p style="margin: 0; font-size: 11px; color: #475569; font-style: italic; font-weight: 500; line-height: 1.4;">
      Digite abaixo o **saldo real exato encontrado na prateleira física**. O sistema calculará a diferença automaticamente e gerará uma movimentação corretiva de acerto para manter o histórico de auditoria impecável.
    </p>
  </div>

  <%= form_with(model: @item, url: estoque_path(@item, tipo: @item.class.name), method: :patch, local: true) do |f| %>
    
    <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box;">
      <%= f.label :estoque_centro, "Saldo Físico Atual na Matriz Centro", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;" %>
      <%= f.number_field :estoque_centro, value: (@item.respond_to?(:saldo_centro) ? @item.saldo_centro : @item.estoque_centro), step: 0.001, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; outline: none; color: #1e293b; font-weight: 500;" %>
    </div>

    <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box;">
      <%= f.label :estoque_pavilhao_novo, "Saldo Físico Atual no Pavilhão Novo", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;" %>
      <%= f.number_field :estoque_pavilhao_novo, value: (@item.respond_to?(:saldo_pavilhao_novo) ? @item.saldo_pavilhao_novo : @item.estoque_pavilhao_novo), step: 0.001, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; outline: none; color: #1e293b; font-weight: 500;" %>
    </div>

    <div style="margin-bottom: 35px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box;">
      <%= f.label :estoque_pavilhao_antigo, "Saldo Físico Atual no Pavilhão Antigo", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;" %>
      <%= f.number_field :estoque_pavilhao_antigo, value: (@item.respond_to?(:saldo_pavilhao_antigo) ? @item.saldo_pavilhao_antigo : @item.estoque_pavilhao_antigo), step: 0.001, style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-size: 14px; outline: none; color: #1e293b; font-weight: 500;" %>
    </div>

    <% if @item.is_a?(Produto) %>
  <div style="margin-bottom: 25px; padding: 15px; background: #fdf2f2; border: 1px solid #fee2e2; border-radius: 8px; text-align: left;">
    <%= f.label :estoque_controlado, style: "display: flex; align-items: center; cursor: pointer; font-size: 13px; color: #991b1b; font-weight: bold;" do %>
      <%= f.check_box :estoque_controlado, style: "margin-right: 10px;" %>
      CONTROLAR ESTOQUE FÍSICO MANUALMENTE
    <% end %>
    <p style="margin: 5px 0 0 25px; font-size: 10px; color: #b91c1c; font-style: italic;">
      Ao desmarcar, este produto será ocultado da tela de estoque (Ideal para itens de produção interna).
    </p>
  </div>
<% end %>

    <div style="text-align: center; box-sizing: border-box; width: 100%;">
      <%= f.submit "SALVAR E GERAR MOVIMENTAÇÃO DE AJUSTE", style: "width: 100%; background-color: #D71920; color: white; padding: 14px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; font-size: 13px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px;" %>
    </div>
    
  <% end %>
</div>