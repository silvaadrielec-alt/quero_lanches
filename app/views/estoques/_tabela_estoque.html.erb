<table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
  <thead>
    <tr style="background-color: #D71920; color: white;">
      <th style="padding: 15px; border-top-left-radius: 15px;">PRODUTO</th>
      <th style="padding: 15px;">MATRIZ</th>
      <th style="padding: 15px;">PAV. NOVO</th>
      <th style="padding: 15px;">PAV. ANTIGO</th>
      <th style="padding: 15px; border-top-right-radius: 15px;">AÇÕES</th>
    </tr>
  </thead>
  <tbody>
    <% colecao.each do |produto| %>
      <tr class="linha-estoque" style="border-bottom: 1px solid #eee; <%= 'background-color: #FFF5F5;' if produto.precisa_reposicao? %>">
        <td style="padding: 15px; text-align: left;">
          <strong><%= produto.nome %></strong>
          <% if produto.precisa_reposicao? %>
            <span style="color: #D71920; font-size: 0.75em; display: block; font-weight: bold;">⚠️ REPOSIÇÃO NECESSÁRIA</span>
          <% end %>
        </td>
        
        <%# MATRIZ - Alterado para precision: 3 %>
        <td style="padding: 15px; <%= 'color: #D71920; font-weight: bold; background-color: #FFE6E6;' if produto.estoque_centro_baixo? %>">
          <%= number_with_precision(produto.estoque_centro, precision: 3, separator: ',') %>
          <span style="font-size: 0.8em; color: #666;"><%= produto.unidade_medida %></span>
        </td>

        <%# PAV. NOVO - Alterado para precision: 3 %>
        <td style="padding: 15px; <%= 'color: #D71920; font-weight: bold; background-color: #FFE6E6;' if produto.estoque_pavilhao_novo_baixo? %>">
          <%= number_with_precision(produto.estoque_pavilhao_novo, precision: 3, separator: ',') %>
          <span style="font-size: 0.8em; color: #666;"><%= produto.unidade_medida %></span>
        </td>

        <%# PAV. ANTIGO - Alterado para precision: 3 %>
        <td style="padding: 15px; <%= 'color: #D71920; font-weight: bold; background-color: #FFE6E6;' if produto.estoque_pavilhao_antigo_baixo? %>">
          <%= number_with_precision(produto.estoque_pavilhao_antigo, precision: 3, separator: ',') %>
          <span style="font-size: 0.8em; color: #666;"><%= produto.unidade_medida %></span>
        </td>
        
        <td style="padding: 15px;">
          <%= form_with url: repor_estoque_path, method: :post, style: "display: flex; flex-direction: column; gap: 5px;" do |f| %>
            <%= f.hidden_field :produto_id, value: produto.id %>
            <%= f.select :unidade, [['Centro', 'centro'], ['Pav. Novo', 'pavilhao_novo'], ['Pav. Antigo', 'pavilhao_antigo']], {}, { style: "font-size: 11px; padding: 2px;" } %>
            <div style="display: flex; gap: 2px;">
              <%# Alteramos o step para 0.001 para aceitar 3 casas decimais %>
              <%= f.number_field :quantidade, placeholder: "Qtd", step: 0.001, min: 0.001, style: "width: 55px; padding: 4px;" %>
              <%= f.submit "Repor", style: "background: #28a745; color: white; border: none; border-radius: 4px; padding: 4px; font-size: 11px; cursor: pointer;" %>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>