<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; background-color: #fdf8f5; font-family: sans-serif; box-sizing: border-box; padding: 20px;">
  
  <div class="card-principal" style="background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); width: 100%; max-width: 450px; border: 2px solid #D71920 !important; text-align: center; box-sizing: border-box;">
    
    <div style="margin-bottom: 25px; text-align: center;">
      <h2 style="color: #D71920; margin: 0; font-weight: bold; font-size: 1.8em; letter-spacing: 0.5px; text-transform: uppercase;">Definir Nova Senha</h2>
      <p style="color: #64748b; font-size: 14px; margin-top: 8px; margin-bottom: 0; line-height: 1.4;">Digite e confirme sua nova senha abaixo para atualizar suas credenciais.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "funcionarios/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :password, "Nova Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 4px; text-transform: uppercase;" %>
        <% if @minimum_password_length %>
          <span style="color: #64748b; font-size: 11px; margin-bottom: 6px;">*(mínimo de <%= @minimum_password_length %> caracteres)</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Digite a nova senha", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 25px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :password_confirmation, "Confirmar Nova Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase;" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Digite a senha novamente", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box;" %>
      </div>

      <div>
        <%= f.submit "Alterar minha senha", style: "width: 100%; background: #D71920; color: white; border: none; padding: 13px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box;" %>
      </div>
    <% end %>

    <div style="margin-top: 25px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
      <%= render "funcionarios/shared/links" %>
    </div>
  </div>
</div>