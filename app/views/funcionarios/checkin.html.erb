<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; background-color: #fdf8f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <div style="background: white; padding: 40px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 450px; border-top: 6px solid #D71920; text-align: center;">
    
    <div style="margin-bottom: 25px;">
      <h2 style="color: #D71920; margin-bottom: 10px; font-weight: bold;">INÍCIO DE TURNO</h2>
      <p style="color: #666;">Olá, <strong><%= current_funcionario.nome %></strong>!<br>Confirme seu posto de trabalho hoje.</p>
    </div>

    <%= form_with url: confirmar_checkin_path, method: :post do |f| %>
      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :unidade, "Unidade de Atendimento", style: "display: block; font-weight: bold; margin-bottom: 8px; color: #444;" %>
        <%= f.select :unidade, 
            Funcionario::UNIDADES, 
            { selected: current_funcionario.unidade }, 
            { id: "unidade-select", style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 10px; background: #fff;" } %>
      </div>

      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :turno, "Turno de Trabalho", style: "display: block; font-weight: bold; margin-bottom: 8px; color: #444;" %>
        <%= f.select :turno, [["Manhã/Tarde", "manha_tarde"], ["Tarde/Noite", "tarde_noite"]], {}, 
            { style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 10px;" } %>
      </div>

      <div id="area-autorizacao" style="display: none; background: #fff3cd; padding: 15px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #ffeeba;">
        <p style="color: #856404; font-size: 0.9em; margin-bottom: 10px;">⚠️ <strong>Atenção:</strong> Você está fora do seu posto padrão. Insira o Código do Gerente:</p>
        <%= f.password_field :codigo_gerente, placeholder: "Código de Autorização", id: "input-codigo", style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px;" %>
      </div>

      <%= f.submit "CONFIRMAR ENTRADA", style: "width: 100%; background-color: #28a745; color: white; padding: 14px; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; font-size: 1em;" %>
    <% end %>

  </div>
</div>

<script>
  // Capturamos a unidade original. Se for nula, tratamos como texto vazio.
  const unidadeOriginal = "<%= current_funcionario.unidade %>".trim();
  const select = document.getElementById('unidade-select');
  const area = document.getElementById('area-autorizacao');
  const inputCodigo = document.getElementById('input-codigo');

  function validarUnidade() {
    // Se o funcionário não tem unidade vinculada OU selecionou uma diferente da dele
    if (unidadeOriginal === "" || select.value !== unidadeOriginal) {
      area.style.display = "block";
      inputCodigo.required = true;
    } else {
      area.style.display = "none";
      inputCodigo.required = false;
    }
  }

  // Executa ao mudar o select
  select.addEventListener('change', validarUnidade);

  // Executa assim que a página carrega (Caso ele já comece sem unidade)
  window.onload = validarUnidade;
</script>