<style>
  /* Remove o olhinho/ícone nativo de revelação de senha em navegadores baseados em Chromium (Edge, Chrome) */
  input::-ms-reveal,
  input::-ms-clear {
    display: none !important;
  }
  
  /* Garante consistência geral para campos de senha em outros engines */
  input::-webkit-contacts-auto-fill-button, 
  input::-webkit-credentials-auto-fill-button {
    position: absolute;
    right: 40px; /* Joga os utilitários de preenchimento do browser para o lado para não cobrir nosso SVG */
  }
</style>


<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; background-color: #fdf8f5; font-family: sans-serif; box-sizing: border-box; padding: 20px;">
  
  <%# CARD DE CHECK-IN COM A MOLDURA VERMELHA OFICIAL %>
  <div class="card-principal" style="background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); width: 100%; max-width: 450px; border: 2px solid #D71920 !important; text-align: center; box-sizing: border-box;">
    
    <%# CABEÇALHO DO TURNO %>
    <div style="margin-bottom: 30px;">
      <h2 style="color: #D71920; margin-bottom: 12px; font-weight: bold; font-size: 1.8em; letter-spacing: 0.5px;">INÍCIO DE TURNO</h2>
      <p style="color: #475569; font-size: 14px; line-height: 1.5; margin: 0;">
        Olá, <strong style="color: #1e293b;"><%= current_funcionario.nome.upcase %></strong>!<br>Confirme seu posto de trabalho hoje.
      </p>
    </div>

    <%= form_with url: confirmar_checkin_path, method: :post do |f| %>
      
      <%# SELECT: UNIDADE DE ATENDIMENTO %>
      <div style="margin-bottom: 22px; text-align: left; display: flex; flex-direction: column;">
        <%= f.collection_select :unidade_id, 
    Unidade.all, :id, :nome, 
    { selected: current_funcionario.unidade_id }, 
    { id: "unidade-select", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; background: #fff; font-size: 14px; color: #1e293b; font-weight: 500; box-sizing: border-box;" } %>
      </div>

      <%# SELECT: TURNO DE TRABALHO %>
      <div style="margin-bottom: 22px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :turno, "Turno de Trabalho", style: "font-size: 12px; font-weight: bold; margin-bottom: 6px; color: #D71920; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.select :turno, ["Manhã/Tarde", "Tarde/Noite", "Integral"], { selected: current_funcionario.turno }, 
            { style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; background: #fff; font-size: 14px; color: #1e293b; font-weight: 500; box-sizing: border-box;" } %>
      </div>

      <%# BLOCO DINÂMICO DE AUTORIZAÇÃO (SÓ EXIBE SE ESTIVER FORA DO POSTO) %>
      <div id="area-autorizacao" style="display: none; background: #fffde7; padding: 18px; border-radius: 10px; margin-bottom: 22px; border: 1px solid #fef08a; box-sizing: border-box; text-align: left;">
        <p style="color: #a16207; font-size: 13px; font-weight: bold; margin-top: 0; margin-bottom: 10px; line-height: 1.4;">
          ⚠️ Atenção: Você está fora do seu posto padrão. Insira o Código do Gerente:
        </p>
        
        <div style="position: relative; width: 100%; box-sizing: border-box;">
          <%= f.password_field :codigo_gerente, placeholder: "Código de Autorização", id: "input-codigo", style: "width: 100%; padding: 11px 45px 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; font-weight: bold; color: #1e293b;" %>
          
          <button type="button" onclick="alternarOlhinhoCheckin()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; width: 24px; height: 24px; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; outline: none;" title="Mostrar/Ocultar Código">
            <svg id="svg-olhinho-checkin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#64748b" style="width: 20px; height: 20px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>
      </div>

      <%# BOTÃO DE ENTRADA ATUALIZADO PARA O VERMELHO CORPORATIVO %>
      <div style="margin-top: 30px;">
        <%= f.submit "CONFIRMAR ENTRADA", style: "width: 100%; background-color: #D71920; color: white; padding: 13px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box;" %>
      </div>
    <% end %>

  </div>
</div>

<script>
document.addEventListener("turbo:load", function() {
  const selectUnidade = document.getElementById('unidade-select');
  const selectTurno = document.querySelector('select[name="turno"]');
  const area = document.getElementById('area-autorizacao');
  const inputCodigo = document.getElementById('input-codigo');
  const svg = document.getElementById('svg-olhinho-checkin');

  if (!area && !selectUnidade) return;

  const unidadeOriginal = "<%= current_funcionario.unidade_id %>".trim();
  const turnoOriginal = "<%= current_funcionario.turno %>".trim();
  const isAdmin = <%= current_funcionario.admin? || false %>;

  if (selectTurno) selectTurno.id = 'turno-select'; 

  function verificarNecessidadeAutorizacao() {
    // 1. Obtém os valores e garante que sejam strings limpas (sem espaços)
    const valorUnidadeAtual = selectUnidade ? selectUnidade.value.toString().trim() : "";
    const valorTurnoAtual = selectTurno ? selectTurno.value.toString().trim() : "";
    
    // 2. Garante que os valores originais também sejam strings limpas
    const originalUnidade = unidadeOriginal.toString().trim();
    const originalTurno = turnoOriginal.toString().trim();

    // 3. Compara
    const mudouUnidade = valorUnidadeAtual !== originalUnidade;
    const mudouTurno = valorTurnoAtual !== originalTurno;

    if (mudouUnidade || mudouTurno) {
      if (area) area.style.display = "block";
      if (inputCodigo) inputCodigo.required = true;
    } else {
      if (area) area.style.display = "none";
      if (inputCodigo) {
        inputCodigo.required = false;
        inputCodigo.value = "";
      }
    }
  }

  window.alternarOlhinhoCheckin = function() {
    if (!inputCodigo || !svg) return;

    if (inputCodigo.type === 'password') {
      inputCodigo.type = 'text';
      svg.innerHTML = `
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
      `;
    } else {
      inputCodigo.type = 'password';
      svg.innerHTML = `
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      `;
    }
  };

  if (selectUnidade) selectUnidade.addEventListener('change', verificarNecessidadeAutorizacao);
  if (selectTurno) selectTurno.addEventListener('change', verificarNecessidadeAutorizacao);

  verificarNecessidadeAutorizacao();
});
</script>