<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; background-color: #fdf8f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <div style="background: white; padding: 40px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 400px; border-top: 6px solid #D71920; text-align: center;">
    
    <div style="margin-bottom: 30px;">
      <h2 style="color: #D71920; margin-bottom: 10px; font-weight: bold; letter-spacing: 1px;">ÁREA DE ACESSO</h2>
      <p style="color: #666; font-size: 0.95em;">Bem-vindo(a) à Cantina Quero Lanches</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :email, "E-mail Profissional", style: "display: block; font-weight: bold; margin-bottom: 8px; color: #444;" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 10px; box-sizing: border-box; outline-color: #D71920;" %>
      </div>

      <%# O campo de senha fica aqui dentro do bloco, onde 'f' existe e funciona! %>
      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :password, "Senha de Acesso", style: "display: block; font-weight: bold; margin-bottom: 8px; color: #444;" %>
        
        <div style="position: relative; width: 100%;">
          <%= f.password_field :password, id: "input-senha-login", placeholder: "Digite sua senha", style: "width: 100%; padding: 12px 45px 12px 12px; border: 1px solid #ddd; border-radius: 10px; box-sizing: border-box; outline-color: #D71920;" %>
          
          <button type="button" onclick="alternarOlhinhoLogin()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; width: 24px; height: 24px; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; outline: none;" title="Mostrar/Ocultar Senha">
            <svg id="svg-olhinho-login" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#666" style="width: 20px; height: 20px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div style="margin-bottom: 25px; text-align: left; display: flex; align-items: center;">
          <%= f.check_box :remember_me, style: "width: 18px; height: 18px; margin-right: 10px; cursor: pointer;" %>
          <%= f.label :remember_me, "Manter-me conectado", style: "font-size: 0.9em; color: #666; cursor: pointer;" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "ENTRAR NO SISTEMA", style: "width: 100%; background-color: #D71920; color: white; padding: 14px; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; transition: background 0.3s; font-size: 1em;" %>
      </div>
    <% end %>

    <div style="margin-top: 25px; border-top: 1px solid #eee; padding-top: 15px;">
      <%= render "funcionarios/shared/links" %>
    </div>
  </div>
</div>

<script>
function alternarOlhinhoLogin() {
  const input = document.getElementById('input-senha-login');
  const svg = document.getElementById('svg-olhinho-login');
  if (!input || !svg) return;

  if (input.type === 'password') {
    input.type = 'text';
    // Aplica o traço diagonal cortando o olho
    svg.innerHTML = `
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
    `;
  } else {
    input.type = 'password';
    // Retorna para o olho aberto original
    svg.innerHTML = `
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    `;
  }
}
</script>