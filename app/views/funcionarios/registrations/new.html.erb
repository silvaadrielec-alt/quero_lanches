<div style="display: flex; justify-content: center; align-items: center; min-height: 85vh; background-color: #fdf8f5; font-family: sans-serif; box-sizing: border-box; padding: 20px;">
  
  <%# CARD DE CADASTRO COM A MOLDURA VERMELHA OFICIAL %>
  <div class="card-principal" style="background: white; padding: 45px 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); width: 100%; max-width: 450px; border: 2px solid #D71920 !important; text-align: center; box-sizing: border-box;">
    
    <%# CABEÇALHO DA TELA %>
    <div style="margin-bottom: 30px;">
      <h2 style="color: #D71920; margin: 0; font-weight: bold; font-size: 2.2em; letter-spacing: 0.5px;">CRIAR CONTA</h2>
      <p style="color: #64748b; font-size: 14px; margin-top: 6px; margin-bottom: 0;">Cadastre suas credenciais de colaborador</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "funcionarios/shared/error_messages", resource: resource %>

      <%# CAMPO: NOME COMPLETO %>
      <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :nome, "Nome Completo", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.text_field :nome, autofocus: true, placeholder: "Digite seu nome completo", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; color: #1e293b; box-sizing: border-box; font-weight: 500;" %>
      </div>

      <%# CAMPO: E-MAIL %>
      <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :email, "E-mail Profissional", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.email_field :email, autocomplete: "email", placeholder: "seu@email.com", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; color: #1e293b; box-sizing: border-box; font-weight: 500;" %>
      </div>

      <%# CAMPO: SENHA %>
      <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :password, style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.3px;" do %>
          Senha de Acesso
        <% end %>
        <% if @minimum_password_length %>
          <span style="color: #64748b; font-size: 11px; margin-bottom: 6px;">*(mínimo de <%= @minimum_password_length %> caracteres)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Crie uma senha forte", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; color: #1e293b; box-sizing: border-box;" %>
      </div>

      <%# CAMPO: CONFIRMAR SENHA %>
      <div style="margin-bottom: 25px; text-align: left; display: flex; flex-direction: column;">
        <%= f.label :password_confirmation, "Confirmar Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita a senha criada", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; color: #1e293b; box-sizing: border-box;" %>
      </div>

      <%# BOTÃO DE CADASTRO VERMELHO OFICIAL %>
      <div>
        <%= f.submit "CADASTRAR MINHA CONTA", style: "width: 100%; background-color: #D71920; color: white; padding: 13px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box;" %>
      </div>
    <% end %>

    <%# LINKS COMPARTILHADOS (VOLTAR PRO LOGIN) EM FORMATO DE BOTÃO EXECUTIVO %>
    <div style="margin-top: 25px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
      <%= render "funcionarios/shared/links" %>
    </div>
  </div>
</div>
