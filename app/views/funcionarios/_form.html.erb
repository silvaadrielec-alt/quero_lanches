<%# 1. Definimos a URL correta para evitar o erro de rota PATCH %>
<% url_destino = @funcionario.persisted? ? funcionario_path(@funcionario) : funcionarios_path %>

<%= form_with(model: @funcionario, url: url_destino, local: true) do |f| %>
  
  <% if @funcionario.errors.any? %>
    <div style="color: red; background: #fee; padding: 10px; border-radius: 5px; margin-bottom: 20px;">
      <h2 style="font-size: 16px;"><%= pluralize(@funcionario.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% @funcionario.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.label :nome, "Nome Completo", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.text_field :nome, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.label :email, "E-mail de Acesso", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.email_field :email, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.label :password, "Senha Provisória", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.password_field :password, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px;", placeholder: @funcionario.persisted? ? "Deixe em branco para não alterar" : "" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.label :password_confirmation, "Confirme a Senha", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.password_field :password_confirmation, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.label :unidade, "Unidade Habitual (Posto Fixo)", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.select :unidade, 
        Funcionario::UNIDADES, 
        { include_blank: "Selecione a Unidade Padrão" }, 
        { style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
  </div>

  <%# --- TURNO --- %>
  <div style="margin-bottom: 20px;">
    <%= f.label :turno, "Turno de Trabalho", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.select :turno, 
        ["Manhã/Tarde", "Tarde/Noite", "Integral"], 
        { include_blank: "Selecione o Turno" }, 
        { style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
    <p style="font-size: 12px; color: #666; margin-top: 5px;">* Define o horário de atuação do funcionário.</p>
  </div>

  <%# --- INTEGRADO: NOVO CAMPO CARGO / FUNÇÃO --- %>
  <div style="margin-bottom: 20px;">
    <%= f.label :cargo, "Cargo / Função", style: "display: block; font-weight: bold; color: #D71920;" %>
    <%= f.select :cargo, 
        ["Gerente", "Caixa", "Atendente", "Auxiliar de Cozinha", "Serviços Gerais"], 
        { include_blank: "Selecione o Cargo" }, 
        { style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
    <p style="font-size: 12px; color: #666; margin-top: 5px;">* Determina a função principal desempenhada na cantina.</p>
  </div>

  <div style="margin-bottom: 20px; padding: 10px; border: 1px dashed #D71920; border-radius: 8px; background-color: #fff;">
    <%= f.label :admin, "Acesso de Administrador?", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 5px;" %>
    <div style="display: flex; align-items: center; gap: 10px;">
      <%= f.check_box :admin, id: "checkbox-admin", style: "width: 20px; height: 20px; cursor: pointer;" %>
      <span style="color: #666; font-size: 14px;">(Permite visualizar faturamentos e gerenciar equipe)</span>
    </div>
  </div>

  <%# --- INTEGRADO: NOVO CAMPO DINÂMICO PARA CÓDIGO DE AUTORIZAÇÃO --- %>
  <div style="margin-bottom: 20px; padding: 15px; border: 2px solid #D71920; border-radius: 8px; background-color: #fff; display: none;" id="bloco-codigo-autorizacao">
    <%= f.label :codigo_autorizacao, "Código de Autorização (PIN do Gerente)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 5px;" %>
    <%= f.text_field :codigo_autorizacao, id: "input-codigo-autorizacao", maxlength: 6, placeholder: "Ex: 9876", style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;" %>
    <p style="font-size: 12px; color: #666; margin-top: 5px; margin-bottom: 0;">* Este código será exigido pelo sistema para validar operações restritas realizadas por funcionários comuns.</p>
  </div>

  <div style="margin-top: 30px;">
    <%= f.submit @funcionario.persisted? ? "SALVAR ALTERAÇÕES" : "CADASTRAR FUNCIONÁRIO", class: "btn-quero", style: "width: 100%;" %>
  </div>

<% end %>

<%# --- LOGICA VISUAL DE EXIBIÇÃO DO CAMPO DE SEGURANÇA --- %>
<script>
function gerenciarCampoCodigo() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  const blocoCodigo = document.getElementById("bloco-codigo-autorizacao");
  const inputCodigo = document.getElementById("input-codigo-autorizacao");

  if (!checkboxAdmin || !blocoCodigo) return;

  if (checkboxAdmin.checked) {
    blocoCodigo.style.display = "block";
    if (inputCodigo) inputCodigo.required = true; // Força o preenchimento se for admin
  } else {
    blocoCodigo.style.display = "none";
    if (inputCodigo) {
      inputCodigo.required = false;
      inputCodigo.value = ""; // Reseta o valor caso o privilégio seja removido
    }
  }
}

function inicializarEventosFuncionario() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  
  if (checkboxAdmin) {
    checkboxAdmin.removeEventListener("change", gerenciarCampoCodigo);
    checkboxAdmin.addEventListener("change", gerenciarCampoCodigo);
  }

  // Executa imediatamente para checar o estado atual (útil na edição de admins existentes)
  gerenciarCampoCodigo();
}

// Vincula os listeners de ciclo de vida do Turbo do Rails
document.addEventListener("turbo:load", inicializarEventosFuncionario);
document.addEventListener("DOMContentLoaded", inicializarEventosFuncionario);
</script>