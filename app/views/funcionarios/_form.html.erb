<% content_for :turbo_cache, "false" %>

<% url_destino = @funcionario.persisted? ? funcionario_path(@funcionario) : funcionarios_path %>

<script src="https://unpkg.com/imask"></script>

<%= form_with(model: @funcionario, url: url_destino, local: true) do |f| %>
  
  <%# MENSAGENS DE ERRO %>
  <% if @funcionario.errors.any? %>
    <div style="color: #dc2626; background: #fef2f2; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #fee2e2; text-align: left;">
      <h2 style="font-size: 15px; font-weight: bold; margin-top: 0;"><%= pluralize(@funcionario.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul style="margin: 5px 0 0 0; padding-left: 20px; font-size: 14px; color: #b91c1c;">
        <% @funcionario.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# CONTEDOR GRID EM DUAS COLUNAS %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px 30px; text-align: left; box-sizing: border-box;">
    
    <%# COLUNA 1: Nome Completo %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :nome, "Nome Completo", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.text_field :nome, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
    </div>

    <%# COLUNA 2: Data de Nascimento %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :data_nascimento, "Data de Nascimento", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.date_field :data_nascimento, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-family: sans-serif; background: #fff;" %>
    </div>

    <%# COLUNA 1: E-mail de Acesso %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :email, "E-mail de Acesso", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.email_field :email, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
    </div>

    <%# COLUNA 2: Cargo / Função %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :cargo, "Cargo / Função", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.select :cargo, 
          ["Gerente", "Caixa", "Atendente", "Auxiliar de Cozinha", "Serviços Gerais"], 
          { include_blank: "Selecione o Cargo..." }, 
          { style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; background: #fff; font-weight: 500;" } %>
    </div>

    <%# COLUNA 1: Telefone %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :telefone, "Telefone (Somente Números)", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.text_field :telefone, id: "input-telefone", maxlength: 15, placeholder: "Ex: (71) 99999-9999", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
    </div>

    <%# COLUNA 2: CPF %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :cpf, "CPF (Opcional)", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.text_field :cpf, id: "input-cpf", maxlength: 14, placeholder: "Ex: 000.000.000-00", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
    </div>

    <%# COLUNA 1: Data de Admissão %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :data_admissao, "Data de Admissão", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.date_field :data_admissao, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-family: sans-serif; background: #fff;" %>
    </div>

    <%# COLUNA 2: Data de Demissão %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :data_demissao, "Data de Demissão (Se houver)", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.date_field :data_demissao, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; font-family: sans-serif; background: #fff;" %>
    </div>

    <%# COLUNA 1: Senha Provisória %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :password, "Senha de Acesso", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.password_field :password, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b;", placeholder: @funcionario.persisted? ? "Deixe em branco para manter atual" : "Digite uma senha provisória" %>
    </div>

    <%# COLUNA 2: Confirme a Senha %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :password_confirmation, "Confirme a Senha", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.password_field :password_confirmation, style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b;", placeholder: "Confirme a senha digitada" %>
    </div>

    <%# COLUNA 1: Unidade Habitual %>
<div style="display: flex; flex-direction: column;">
  <%= f.label :unidade_id, "Unidade Habitual (Posto Fixo)", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
  <%= f.collection_select :unidade_id, 
      Unidade.all, :id, :nome, 
      { include_blank: "Selecione a Unidade Padrão..." }, 
      { style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; background: #fff; font-weight: 500;" } %>
</div>

    <%# COLUNA 2: Turno de Trabalho %>
    <div style="display: flex; flex-direction: column;">
      <%= f.label :turno, "Turno de Trabalho", style: "font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= f.select :turno, 
          ["Manhã/Tarde", "Tarde/Noite", "Integral"], 
          { include_blank: "Selecione o Turno..." }, 
          { style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; color: #1e293b; background: #fff; font-weight: 500;" } %>
    </div>

  </div>

  <%# CONTROLES DE PERMISSÃO / ADMIN (FORA DO GRID) %>
  <div style="margin-top: 30px;">
    
    <%# Checkbox de Acesso Administrador %>
    <div style="padding: 18px; border: 1px dashed #cbd5e1; border-radius: 10px; background-color: #f8fafc; text-align: left; box-sizing: border-box; margin-bottom: 20px;">
      <%= f.label :admin, "Nível de Acesso da Conta", style: "display: block; font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <div style="display: flex; align-items: center; gap: 12px;">
        <%= f.check_box :admin, id: "checkbox-admin", style: "width: 22px; height: 22px; cursor: pointer;" %>
        <span style="color: #334155; font-size: 14px; font-weight: 500;">Conceder privilégios de <strong>Administrador / Gerência</strong></span>
      </div>
    </div>

    <%# Bloco Dinâmico do PIN do Gerente - CORRIGIDO PARA NÃO VAZAR A BORDA %>
    <div style="padding: 22px; border: 2px solid #D71920; border-radius: 10px; background-color: #fff; display: none; text-align: left; box-sizing: border-box; box-shadow: 0 4px 10px rgba(215,25,32,0.03);" id="bloco-codigo-autorizacao">
      <%= f.label :codigo_autorizacao, "Código de Autorização (PIN do Gerente)", style: "display: block; font-size: 12px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%# ADICIONADO 'box-sizing: border-box;' PARA TRAVAR O CAMPO DENTRO DA LINHA VERMELHA %>
      <%= f.text_field :codigo_autorizacao, id: "input-codigo-autorizacao", maxlength: 6, placeholder: "Ex: 9876", style: "width: 100%; padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; font-weight: bold; color: #1e293b; box-sizing: border-box;" %>
      <p style="font-size: 12px; color: #64748b; margin-top: 8px; margin-bottom: 0; line-height: 1.4;">* Este código será exigido pelo sistema para validar operações restritas realizadas por funcionários comuns em outras telas.</p>
    </div>

  </div>

  <%# BOTÃO DE SUBMIT PREMIUM NO RODAPÉ %>
  <div style="margin-top: 35px; text-align: center;">
    <%= f.submit @funcionario.persisted? ? "SALVAR ALTERAÇÕES" : "CADASTRAR FUNCIONÁRIO", 
                 style: "background: #D71920; color: white; border: none; padding: 13px 40px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; width: 100%; box-sizing: border-box;" %>
  </div>

<% end %>

<script>
function gerenciarCampoCodigo() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  const blocoCodigo = document.getElementById("bloco-codigo-autorizacao");
  const inputCodigo = document.getElementById("input-codigo-autorizacao");

  if (!checkboxAdmin || !blocoCodigo) return;

  if (checkboxAdmin.checked) {
    blocoCodigo.style.display = "block";
    if (inputCodigo) inputCodigo.required = true;
  } else {
    blocoCodigo.style.display = "none";
    if (inputCodigo) {
      inputCodigo.required = false;
      inputCodigo.value = "";
    }
  }
}

function aplicarMascarasDiretas() {
  const inputTelefone = document.getElementById("input-telefone");
  const inputCpf = document.getElementById("input-cpf");

  if (inputTelefone) {
    let mudando = false;
    inputTelefone.addEventListener("input", function(e) {
      if (mudando) return;
      mudando = true;

      let v = e.target.value.replace(/\D/g, ""); 
      if (v.length > 11) v = v.slice(0, 11);     
      
      if (v.length > 7) {
        e.target.value = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
      } else if (v.length > 2) {
        e.target.value = `(${v.slice(0,2)}) ${v.slice(2)}`;
      } else if (v.length > 0) {
        e.target.value = `(${v}`;
      } else {
        e.target.value = "";
      }
      
      mudando = false;
    });
  }

  if (inputCpf) {
    let mudandoCpf = false;
    inputCpf.addEventListener("input", function(e) {
      if (mudandoCpf) return;
      mudandoCpf = true;

      let v = e.target.value.replace(/\D/g, ""); 
      if (v.length > 11) v = v.slice(0, 11);     
      
      if (v.length > 9) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3,6)}.${v.slice(6,9)}-${v.slice(9)}`;
      } else if (v.length > 6) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3,6)}.${v.slice(6)}`;
      } else if (v.length > 3) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3)}`;
      } else if (v.length > 0) {
        e.target.value = v;
      } else {
        e.target.value = "";
      }

      mudandoCpf = false;
    });
  }

  gerenciarCampoCodigo();
}

document.addEventListener("turbo:load", aplicarMascarasDiretas);
document.addEventListener("turbo:render", aplicarMascarasDiretas);

if (document.readyState === "complete" || document.readyState === "interactive") {
  aplicarMascarasDiretas();
}

document.addEventListener("turbo:load", function() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  if (checkboxAdmin) {
    checkboxAdmin.removeEventListener("change", gerenciarCampoCodigo);
    checkboxAdmin.addEventListener("change", gerenciarCampoCodigo);
  }
});
</script>