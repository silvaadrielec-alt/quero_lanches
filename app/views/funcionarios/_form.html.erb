<% content_for :turbo_cache, "false" %>

<% url_destino = @funcionario.persisted? ? funcionario_path(@funcionario) : funcionarios_path %>

<script src="https://unpkg.com/imask"></script>

<%= form_with(model: @funcionario, url: url_destino, local: true) do |f| %>
  
  <% if @funcionario.errors.any? %>
    <div style="color: red; background: #fee; padding: 15px; border-radius: 5px; margin-bottom: 40px;">
      <h2 style="font-size: 16px;"><%= pluralize(@funcionario.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% @funcionario.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 40px;">
    <%= f.label :nome, "Nome Completo", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.text_field :nome, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :email, "E-mail de Acesso", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.email_field :email, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="display: flex; gap: 40px; margin-bottom: 40px;">
    <div style="flex: 1;">
      <%= f.label :telefone, "Telefone (Somente Números)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
      <%= f.text_field :telefone, 
          id: "input-telefone", 
          maxlength: 15, 
          placeholder: "Ex: 71999999999", 
          style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" %>
    </div>
    <div style="flex: 1;">
      <%= f.label :cpf, "CPF (Opcional - Somente Números)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
      <%= f.text_field :cpf, 
          id: "input-cpf", 
          maxlength: 14, 
          title: "Digite o CPF contendo apenas os 11 números",
          placeholder: "Ex: 00000000000", 
          style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" %>
    </div>
  </div>

  <div style="display: flex; gap: 40px; margin-bottom: 40px;">
    <div style="flex: 1;">
      <%= f.label :data_admissao, "Data de Admissão", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
      <%= f.date_field :data_admissao, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" %>
    </div>
    <div style="flex: 1;">
      <%= f.label :data_demissao, "Data de Demissão (Se houver)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
      <%= f.date_field :data_demissao, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" %>
    </div>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :password, "Senha Provisória", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.password_field :password, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;", placeholder: @funcionario.persisted? ? "Deixe em branco para não alterar" : "" %>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :password_confirmation, "Confirme a Senha", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.password_field :password_confirmation, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" %>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :unidade, "Unidade Habitual (Posto Fixo)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.select :unidade, 
        Funcionario::UNIDADES, 
        { include_blank: "Selecione a Unidade Padrão" }, 
        { style: "width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :turno, "Turno de Trabalho", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.select :turno, 
        ["Manhã/Tarde", "Tarde/Noite", "Integral"], 
        { include_blank: "Selecione o Turno" }, 
        { style: "width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
    <p style="font-size: 13px; color: #666; margin-top: 8px;">* Define o horário de atuação do funcionário.</p>
  </div>

  <div style="margin-bottom: 40px;">
    <%= f.label :cargo, "Cargo / Função", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.select :cargo, 
        ["Gerente", "Caixa", "Atendente", "Auxiliar de Cozinha", "Serviços Gerais"], 
        { include_blank: "Selecione o Cargo" }, 
        { style: "width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px; background: #fff;" } %>
    <p style="font-size: 13px; color: #666; margin-top: 8px;">* Determina a função principal desempenhada na cantina.</p>
  </div>

  <div style="margin-bottom: 40px; padding: 15px; border: 1px dashed #D71920; border-radius: 8px; background-color: #fff;">
    <%= f.label :admin, "Acesso de Administrador?", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <div style="display: flex; align-items: center; gap: 10px;">
      <%= f.check_box :admin, id: "checkbox-admin", style: "width: 22px; height: 22px; cursor: pointer;" %>
      <span style="color: #666; font-size: 14px;">(Permite visualizar faturamentos e gerenciar equipe)</span>
    </div>
  </div>

  <div style="margin-bottom: 40px; padding: 20px; border: 2px solid #D71920; border-radius: 8px; background-color: #fff; display: none;" id="bloco-codigo-autorizacao">
    <%= f.label :codigo_autorizacao, "Código de Autorização (PIN do Gerente)", style: "display: block; font-weight: bold; color: #D71920; margin-bottom: 8px;" %>
    <%= f.text_field :codigo_autorizacao, id: "input-codigo-autorizacao", maxlength: 6, placeholder: "Ex: 9876", style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;" %>
    <p style="font-size: 13px; color: #666; margin-top: 8px; margin-bottom: 0;">* Este código será exigido pelo sistema para validar operações restritas realizadas por funcionários comuns.</p>
  </div>

  <div style="margin-top: 50px;">
    <%= f.submit @funcionario.persisted? ? "SALVAR ALTERAÇÕES" : "CADASTRAR FUNCIONÁRIO", class: "btn-quero", style: "width: 100%; padding: 12px;" %>
  </div>

<% end %>

<script>
function gerenciarCampoCodigo() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  const blocoCodigo = document.getElementById("bloco-codigo-autorizacao");
  const inputCodigo = document.getElementById("input-codigo-autorizacao");

  if (!checkboxAdmin || !blocoCodigo) return;

  if (checkboxAdmin.checked) {
    blocoCodigo.style.display = "block";
    if (inputCodigo) inputCodigo.required = true;
  } else {
    blocoCodigo.style.display = "none";
    if (inputCodigo) {
      inputCodigo.required = false;
      inputCodigo.value = "";
    }
  }
}

function aplicarMascarasDiretas() {
  const inputTelefone = document.getElementById("input-telefone");
  const inputCpf = document.getElementById("input-cpf");

  if (inputTelefone) {
    let mudando = false;
    inputTelefone.addEventListener("input", function(e) {
      if (mudando) return;
      mudando = true;

      let v = e.target.value.replace(/\D/g, ""); 
      if (v.length > 11) v = v.slice(0, 11);     
      
      if (v.length > 7) {
        e.target.value = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
      } else if (v.length > 2) {
        e.target.value = `(${v.slice(0,2)}) ${v.slice(2)}`;
      } else if (v.length > 0) {
        e.target.value = `(${v}`;
      } else {
        e.target.value = "";
      }
      
      mudando = false;
    });
  }

  if (inputCpf) {
    let mudandoCpf = false;
    inputCpf.addEventListener("input", function(e) {
      if (mudandoCpf) return;
      mudandoCpf = true;

      let v = e.target.value.replace(/\D/g, ""); 
      if (v.length > 11) v = v.slice(0, 11);     
      
      if (v.length > 9) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3,6)}.${v.slice(6,9)}-${v.slice(9)}`;
      } else if (v.length > 6) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3,6)}.${v.slice(6)}`;
      } else if (v.length > 3) {
        e.target.value = `${v.slice(0,3)}.${v.slice(3)}`;
      } else if (v.length > 0) {
        e.target.value = v; // CORREÇÃO: Permite digitar e exibir os 3 primeiros números na tela
      } else {
        e.target.value = "";
      }

      mudandoCpf = false;
    });
  }

  gerenciarCampoCodigo();
}

document.addEventListener("turbo:load", aplicarMascarasDiretas);
document.addEventListener("turbo:render", aplicarMascarasDiretas);

if (document.readyState === "complete" || document.readyState === "interactive") {
  aplicarMascarasDiretas();
}

document.addEventListener("turbo:load", function() {
  const checkboxAdmin = document.getElementById("checkbox-admin");
  if (checkboxAdmin) {
    checkboxAdmin.removeEventListener("change", gerenciarCampoCodigo);
    checkboxAdmin.addEventListener("change", gerenciarCampoCodigo);
  }
});
</script>