<p style="color: green"><%= notice %></p>

<%= render @funcionario %>

<div style="margin-top: 20px;">
  <%= link_to "Editar este funcionário", edit_funcionario_path(@funcionario), style: "color: #0000FF; text-decoration: underline; font-family: sans-serif;" %> |
  <%= link_to "Voltar aos funcionários", funcionarios_path, style: "color: #0000FF; text-decoration: underline; font-family: sans-serif;" %>

  <div style="margin-top: 30px;">
    <%= button_to "Excluir este funcionário", @funcionario, method: :delete, data: { confirm: "Tem certeza?" }, style: "background: #ff4444; color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer;" %>
  </div>
</div>
