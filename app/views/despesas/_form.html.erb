<%# --- MODAL DE AUTORIZAÇÃO FINANCEIRA PREMIUM --- %>
<div id="modal-autorizacao-gerente" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; box-sizing: border-box; padding: 0 15px;">
  <div style="background: white; padding: 35px 30px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); width: 100%; max-width: 400px; text-align: center; font-family: sans-serif; box-sizing: border-box; border: 1px solid #e2e8f0;">
    <h3 style="color: #D71920; margin-top: 0; margin-bottom: 8px; font-weight: bold; font-size: 1.2em; text-transform: uppercase; letter-spacing: 0.5px;">Autorização do Gerente</h3>
    <p id="texto-modal-seguranca" style="color: #64748b; font-size: 14px; margin-bottom: 25px; line-height: 1.4;">Esta ação requer privilégios de gerente. Digite o código de segurança de 6 dígitos para salvar:</p>
    
    <div style="position: relative; margin-bottom: 25px; width: 100%;">
      <input type="password" id="input-pin-gerente" maxlength="6" placeholder="••••••" style="width: 100%; padding: 12px 75px 12px 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 1.5em; text-align: center; letter-spacing: 5px; outline: none; box-sizing: border-box; background: #f8fafc; color: #1e293b; font-weight: bold;">
      
      <button type="button" onclick="alternarVisibilidadePin()" id="btn-olhinho" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 11px; font-weight: bold; color: #64748b; cursor: pointer; padding: 0; line-height: 1; outline: none; text-transform: uppercase; letter-spacing: 0.5px;" title="Mostrar/Ocultar Código">
        Mostrar
      </button>
    </div>
    
    <div style="display: flex; gap: 12px; justify-content: center; align-items: stretch; width: 100%; box-sizing: border-box;">
      <button type="button" onclick="fecharModalAutorizacao()" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 11px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; flex: 1; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Cancelar</button>
      <button type="button" onclick="processarPinRemoto()" style="background: #D71920; color: white; border: none; padding: 11px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; flex: 1; font-size: 13px; box-shadow: 0 4px 10px rgba(215, 25, 32, 0.18); text-transform: uppercase; letter-spacing: 0.5px;">Confirmar</button>
    </div>
  </div>
</div>

<%# --- FORMULÁRIO COM CONTROLE SEGURO DE UNIDADES --- %>
<%= form_with(model: despesa, id: "form-despesa") do |form| %>
  
  <%# EXIBIÇÃO DE ERROS NO PADRÃO TONAL PREMIUM %>
  <% if despesa.errors.any? %>
    <div style="color: #dc2626; background: #fef2f2; padding: 18px; border-radius: 8px; margin-bottom: 25px; border: 1px solid #fee2e2; text-align: left; box-sizing: border-box; font-family: sans-serif; font-size: 14px;">
      <h2 style="font-size: 15px; font-weight: bold; margin-top: 0; text-transform: uppercase; letter-spacing: 0.3px;">
        <%= despesa.errors.count %> <%= despesa.errors.count > 1 ? "erros impediram" : "erro impediu" %> de salvar a despesa:
      </h2>
      <ul style="margin: 8px 0 0 0; padding-left: 20px; color: #b91c1c; line-height: 1.4;">
        <% despesa.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# CAPTURA AUTOMÁTICA DO TURNO %>
  <%= form.hidden_field :turno, value: (despesa.turno || current_funcionario&.turno || "Geral") %>

  <%# CATEGORIA %>
  <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
    <%= form.label :categoria, "Categoria da Despesa", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.select :categoria, ["Água/Luz/Internet", "Pagamento Funcionário", "Compra de Mercadoria", "Produtos de Limpeza", "Serviços de Limpeza", "Outros"], 
        { prompt: "Selecione o tipo de gasto" }, 
        { id: "select-categoria", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background-color: white; outline: none; color: #1e293b;" } %>
  </div>

  <%# DESCRIÇÃO %>
  <div style="margin-bottom: 20px; text-align: left; display: none; box-sizing: border-box; font-family: sans-serif;" id="bloco-descricao">
    <%= form.label :descricao, "Descrição da Despesa", id: "label-descricao", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.text_field :descricao, id: "input-descricao", placeholder: "Ex: Conta de Luz Maio", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; outline: none; color: #1e293b; font-weight: 500;" %>
  </div>

  <%# VALOR %>
  <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
    <%= form.label :valor, "Valor da Despesa (R$)", style: "font-size: 11px; font-weight: bold; color: #16a34a; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.number_field :valor, step: 0.01, placeholder: "0,00", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; outline: none; color: #1e293b; font-weight: bold;" %>
  </div>

  <%# 🔒 BLOCO DE UNIDADE INTELIGENTE COM DEFENSA CONTRA ERROS %>
  <% unidade_definida = despesa.unidade.presence || current_funcionario&.unidade %>
  
  <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box; font-family: sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; width: 100%;">
      <%= form.label :unidade, "Unidade Alocada", style: "font-size: 11px; font-weight: bold; color: #D71920; text-transform: uppercase; letter-spacing: 0.3px; margin: 0;" %>
      
      <% if current_funcionario&.admin? %>
        <button type="button" id="btn-alterar-unidade" onclick="solicitarTrocaUnidadeAdmin()" style="background: none; border: none; color: #007bff; text-decoration: none; font-size: 11px; font-weight: bold; cursor: pointer; text-transform: uppercase; padding: 0; outline: none; letter-spacing: 0.3px;">[ Alterar Unidade ]</button>
      <% end %>
    </div>

    <%# Box cinza estático premium %>
    <div id="box-unidade-travada" style="width: 100%; padding: 11px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; background-color: #f1f5f9; color: #1e293b; font-weight: bold; text-transform: uppercase; display: block; border-bottom: 2px solid #cbd5e1;">
      <span id="txt-unidade-atual"><%= unidade_definida.respond_to?(:nome) ? unidade_definida.nome : unidade_definida.to_s.humanize %></span> <span style="font-weight: normal; color: #64748b; font-size: 13px; text-transform: none;">(Sua Unidade Corrente)</span>
    </div>

    <%# Campo real oculto que sempre enviará o valor correto %>
    <%= form.hidden_field :unidade_id, id: "hidden-unidade-input", value: unidade_definida.id %>

    <% if current_funcionario&.admin? %>
      <%# Select alternativo (Usa name alternativo para não bater com o hidden_field) %>
      <div id="wrapper-select-unidade" style="display: none; width: 100%;">
        <%= select_tag :unidade_temporaria, options_for_select([["Matriz Centro", "matriz"], ["Pavilhão Novo", "pavilhao_novo"], ["Pavilhão Antigo", "pavilhao_antigo"]], unidade_definida), id: "select-unidade-admin", onchange: "sincronizarInputUnidade(this.value)", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background-color: white; outline: none; color: #1e293b; height: 41px; font-weight: 500;" %>
      </div>
    <% end %>
  </div>

  <%# CHECKBOX STATUS PAGO %>
  <div style="margin-bottom: 22px; display: flex; align-items: center; gap: 12px; text-align: left; background: #f8fafc; padding: 14px 18px; border-radius: 8px; border: 1px solid #e2e8f0; box-sizing: border-box; border-bottom: 2px solid #cbd5e1; font-family: sans-serif;">
    <%= form.check_box :pago, id: "check-pago", style: "width: 20px; height: 20px; cursor: pointer; margin: 0; accent-color: #D71920;" %>
    <%= form.label :pago, "Esta despesa já foi paga?", style: "font-weight: bold; color: #1e293b; cursor: pointer; font-size: 14px; user-select: none; text-transform: uppercase; letter-spacing: 0.3px;" %>
  </div>

  <%# DATA DE PAGAMENTO (SE PAGO) %>
  <div style="margin-bottom: 20px; text-align: left; display: none; box-sizing: border-box; font-family: sans-serif;" id="bloco-data-pagamento">
    <%= form.label :data_pagamento, "Data em que foi Paga", style: "font-size: 11px; font-weight: bold; color: #16a34a; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 6px; display: block;" %>
    <%= form.date_field :data_pagamento, value: (despesa.data_pagamento || Date.today), style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; outline: none; color: #1e293b; font-weight: 500;" %>
  </div>

  <%# DATA DE VENCIMENTO (SE PENDENTE) %>
  <div style="margin-bottom: 20px; text-align: left; display: none; box-sizing: border-box; font-family: sans-serif;" id="bloco-data-vencimento">
    <%= form.label :data_vencimento, "Data de Vencimento (Prazo Limite)", style: "font-size: 11px; font-weight: bold; color: #dc2626; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 6px; display: block;" %>
    <%= form.date_field :data_vencimento, value: (despesa.data_vencimento || Date.today), style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; outline: none; color: #1e293b; font-weight: 500;" %>
  </div>

  <%# BOTÃO SALVAR NO PADRÃO CORPORATIVO EM CAIXA %>
  <div style="text-align: center; margin-top: 30px; font-family: sans-serif;">
    <button type="button" onclick="validarAcessoDespesa()" style="width: 100%; padding: 14px; background-color: #D71920; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; box-shadow: 0 4px 10px rgba(215, 25, 32, 0.18); letter-spacing: 0.5px; text-transform: uppercase;">
      Salvar Despesa
    </button>
  </div>
<% end %>

<script>
let acaoModalCorrente = "salvar_formulario"; 

function gerenciarCampos() {
  const selectCategoria = document.getElementById("select-categoria");
  const blocoDescricao = document.getElementById("bloco-descricao");
  const labelDescricao = document.getElementById("label-descricao");
  const inputDescricao = document.getElementById("input-descricao");

  if (!selectCategoria || !blocoDescricao) return;
  const valorSelecionado = selectCategoria.value;

  if (valorSelecionado === "") {
    blocoDescricao.style.display = "none";
  } else if (valorSelecionado === "Outros") {
    blocoDescricao.style.display = "block";
    labelDescricao.innerText = "Descreva detalhadamente este Gasto Extra:";
    inputDescricao.placeholder = "Ex: Conserto do liquidificador da copa";
  } else {
    blocoDescricao.style.display = "block";
    labelDescricao.innerText = "Descrição da Despesa";
    inputDescricao.placeholder = "Ex: Referente ao mês atual";
  }
}

function gerenciarDatas() {
  const checkPago = document.getElementById("check-pago");
  const blocoPagamento = document.getElementById("bloco-data-pagamento");
  const blocoVencimento = document.getElementById("bloco-data-vencimento");

  if (!checkPago || !blocoPagamento || !blocoVencimento) return;

  if (checkPago.checked) {
    blocoPagamento.style.display = "block";
    blocoVencimento.style.display = "none";
  } else {
    blocoPagamento.style.display = "none";
    blocoVencimento.style.display = "block";
  }
}

function sincronizarInputUnidade(valor) {
  const hiddenInput = document.getElementById("hidden-unidade-input");
  if (hiddenInput) hiddenInput.value = valor;
}

function inicializarEventosForm() {
  const selectCategoria = document.getElementById("select-categoria");
  const checkPago = document.getElementById("check-pago");
  
  if (selectCategoria) {
    selectCategoria.removeEventListener("change", gerenciarCampos);
    selectCategoria.addEventListener("change", gerenciarCampos);
  }
  if (checkPago) {
    checkPago.removeEventListener("change", gerenciarDatas);
    checkPago.addEventListener("change", gerenciarDatas);
  }

  gerenciarCampos();
  gerenciarDatas();
}

document.addEventListener("turbo:load", inicializarEventosForm);
document.addEventListener("DOMContentLoaded", inicializarEventosForm);

// --- 🔒 ENGENHARIA DE SEGURANÇA E VALIDAÇÃO DINÂMICA ---

window.solicitarTrocaUnidadeAdmin = function() {
  acaoModalCorrente = "liberar_unidade";
  
  const labelModal = document.getElementById("texto-modal-seguranca");
  if (labelModal) labelModal.innerText = "Confirme seu código de segurança de administrador para desbloquear a troca de unidade:";

  const modal = document.getElementById("modal-autorizacao-gerente");
  if (modal) {
    modal.style.display = "flex";
    const inputPin = document.getElementById("input-pin-gerente");
    if (inputPin) {
      inputPin.value = "";
      inputPin.type = "password";
      inputPin.focus();
    }
  }
};

window.validarAcessoDespesa = function() {
  const ehAdmin = <%= current_funcionario&.admin? || false %>;
  const formulario = document.getElementById('form-despesa');

  if (ehAdmin) {
    formulario.submit();
  } else {
    acaoModalCorrente = "salvar_formulario";
    const labelModal = document.getElementById("texto-modal-seguranca");
    if (labelModal) labelModal.innerText = "Esta ação requer privilégios de gerente. Digite o código de segurança de 6 dígitos para salvar:";

    const modal = document.getElementById("modal-autorizacao-gerente");
    if (modal) {
      modal.style.display = "flex";
      const inputPin = document.getElementById("input-pin-gerente");
      if (inputPin) {
        inputPin.value = "";
        inputPin.type = "password"; 
        inputPin.style.letterSpacing = "5px";
        inputPin.focus();
      }
    }
  }
};

window.fecharModalAutorizacao = function() {
  const modal = document.getElementById("modal-autorizacao-gerente");
  const inputPin = document.getElementById("input-pin-gerente");
  
  if (modal) modal.style.display = "none";
  if (inputPin) {
    inputPin.type = "password"; 
    inputPin.style.letterSpacing = "5px";
  }
};

window.alternarVisibilidadePin = function() {
  const inputPin = document.getElementById("input-pin-gerente");
  const btnOlhinho = document.getElementById("btn-olhinho");
  if (!inputPin) return;

  if (inputPin.type === "password") {
    inputPin.type = "text";
    inputPin.style.letterSpacing = "normal"; 
    if (btnOlhinho) btnOlhinho.innerText = "Ocultar";
  } else {
    inputPin.type = "password";
    inputPin.style.letterSpacing = "5px";    
    if (btnOlhinho) btnOlhinho.innerText = "Mostrar";
  }
};

window.processarPinRemoto = function() {
  const inputPin = document.getElementById("input-pin-gerente");
  const codigo = inputPin ? inputPin.value : "";
  const formulario = document.getElementById('form-despesa');

  if (!codigo) {
    Swal.fire({ icon: 'warning', title: 'Atenção', text: 'Por favor, informe o código de autorização.' });
    return;
  }

  fetch("/autorizar_gerente", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ codigo: codigo })
  })
  .then(response => response.json())
  .then(data => {
    if (data.autorizado) {
      fecharModalAutorizacao();
      
      if (acaoModalCorrente === "liberar_unidade") {
        document.getElementById("box-unidade-travada").style.display = "none";
        document.getElementById("wrapper-select-unidade").style.display = "block";
        
        const selectReal = document.getElementById("select-unidade-admin");
        if (selectReal) sincronizarInputUnidade(selectReal.value);
        
        Swal.fire({
          title: "Liberado!",
          text: "Seleção de Unidades liberada com sucesso!",
          icon: "success",
          confirmButtonColor: "#16a34a"
        });
      } 
      else if (acaoModalCorrente === "excluir_despesa") {
        // Nova ação integrada: prossegue para a confirmação visual da exclusão
        window.confirmarExclusaoFinal(window.despesaParaExcluir);
      }
      else {
        // Ação padrão (salvar_formulario)
        formulario.submit();
      }
    } else {
      Swal.fire({
        title: "Acesso Negado",
        text: "Código Inválido ou Usuário não é Administrador! Operação cancelada.",
        icon: "error",
        confirmButtonColor: "#D71920"
      });
      fecharModalAutorizacao();
    }
  })
  .catch(() => {
    Swal.fire({
      title: "Erro",
      text: "Erro ao processar a validação de segurança remota.",
      icon: "error",
      confirmButtonColor: "#64748b"
    });
    fecharModalAutorizacao();
  });
};
</script>