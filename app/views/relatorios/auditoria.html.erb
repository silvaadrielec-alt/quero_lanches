<style>
  .status-entrada { color: #28a745; font-weight: bold; } /* Verde para reposição/estorno */
  .status-saida { color: #d71920; font-weight: bold; }   /* Vermelho para vendas */
  .tabela-auditoria { width: 100%; border-collapse: collapse; margin-top: 20px; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; }
  .tabela-auditoria th { background: #333; color: white; padding: 12px; text-align: left; text-transform: uppercase; font-size: 0.85em; }
  .tabela-auditoria td { padding: 12px; border-bottom: 1px solid #eee; font-family: sans-serif; }
  .tabela-auditoria tr:hover { background: #fff9f9; }
  .badge-unidade { background: #f0f0f0; padding: 2px 8px; border-radius: 4px; font-size: 0.8em; font-weight: bold; color: #555; }
</style>

<div style="padding: 30px;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #D71920; padding-bottom: 10px; margin-bottom: 20px;">
    <h2 style="color: #7D3C98; margin: 0;">
       Painel de Auditoria e Rastreabilidade
    </h2>
    <span style="background: #D71920; color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.8em; font-weight: bold;">
      ESTOQUE EM TEMPO REAL
    </span>
  </div>
  
  <p style="color: #666;">Este log registra todas as baixas automáticas de vendas (Saídas) e reposições manuais ou estornos (Entradas).</p>

  <table class="tabela-auditoria">
    <thead>
      <tr>
        <th>Data/Hora</th>
        <th>Responsável</th>
        <th>Unidade</th>
        <th>Item / Insumo</th>
        <th>Ação</th>
        <th>Qtd</th>
      </tr>
    </thead>
    <tbody>
      <% @movimentacoes.each do |log| %>
        <tr>
          <td style="color: #888; font-size: 0.9em;"><%= log.created_at.strftime("%d/%m/%y %H:%M") %></td>
          
          <td><strong><%= log.funcionario&.nome || "Sistema" %></strong></td>
          
          <td><span class="badge-unidade"><%= log.unidade&.upcase %></span></td>
          
          <td><%= log.produto&.nome || "Item removido" %></td>
          
          <% status_classe = log.tipo_movimentacao.to_s.upcase.include?('ENTRADA') ? 'status-entrada' : 'status-saida' %>
          <td class="<%= status_classe %>">
            <%= log.tipo_movimentacao.to_s.upcase %>
          </td>
          
          <td style="font-weight: bold;">
            <% 
              qtd_numerica = log.quantidade.to_f
              produto_log = log.produto
              unidade_medida = produto_log&.respond_to?(:unidade_medida) ? produto_log.unidade_medida.to_s.downcase.strip : "unidade"
              nome_prod = produto_log&.nome.to_s.downcase

              if log.tipo_movimentacao.to_s.upcase.include?('SAÍDA') && produto_log
                # 1. VERIFICA SE É UM INSUMO SEGUIDO POR FICHA TÉCNICA
                comp_como_insumo = Composicao.find_by(insumo_id: produto_log.id)
                
                if comp_como_insumo && comp_como_insumo.unidade_medida_uso.present?
                  unidade_medida = comp_como_insumo.unidade_medida_uso.to_s.downcase.strip
                
                # 2. SE FOR O PRODUTO PRINCIPAL LÍQUIDO (SUCO/CAFÉ), RECONSTRÓI O VOLUME BASEADO NO GASTO DE INSUMO
                elsif unidade_medida == 'litro' && (nome_prod.include?('suco') || nome_prod.include?('vitamina') || nome_prod.include?('café') || nome_prod.include?('cafe'))
                  # Busca no mesmo bloco de tempo se houve baixa de laranja ou insumo correspondente para decifrar a dose
                  log_insumo_irmao = @movimentacoes.find { |m| m.created_at == log.created_at && m.id != log.id && m.produto&.nome&.downcase&.include?('laranja') }
                  
                  if log_insumo_irmao
                    laranjas_gastas = log_insumo_irmao.quantidade.to_f
                    case laranjas_gastas
                    when 4.0  then qtd_numerica = 200; unidade_medida = "ml"
                    when 6.0  then qtd_numerica = 300; unidade_medida = "ml"
                    when 10.0 then qtd_numerica = 500; unidade_medida = "ml"
                    when 14.0 then qtd_numerica = 700; unidade_medida = "ml"
                    when 20.0 then qtd_numerica = 1; unidade_medida = "litro"
                    end
                  end
                end
              end
              
              qtd_formatada = qtd_numerica == qtd_numerica.to_i ? qtd_numerica.to_i.to_s : sprintf("%.2f", qtd_numerica).gsub('.', ',')
              
              if qtd_numerica > 1
                unidade_medida = case unidade_medida
                                 when "unidade" then "unidades"
                                 when "fatia"   then "fatias"
                                 when "rodela"  then "rodelas"
                                 when "folha"   then "folhas"
                                 when "litro"   then "litros"
                                 when "quilo"   then "quilos"
                                 when "un"      then "un"
                                 when "kg"      then "kg"
                                 when "ml"      then "ml"
                                 else 
                                   unidade_medida.end_with?('s') ? unidade_medida : "#{unidade_medida}s"
                                 end
              end
            %>
            <%= "#{qtd_formatada} #{unidade_medida}" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  
  <div style="margin-top: 25px; display: flex; gap: 10px;">
    <%= link_to exportar_auditoria_path(format: :csv), class: "btn-exportar", style: "background: #1D6F42; color: white; padding: 12px 20px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-flex; align-items: center; gap: 8px;" do %>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      Exportar Excel (.CSV)
    <% end %>
  </div>
</div>