<style>
  /* --- ESTILO PARA A TELA (Navegação) --- */
  .conteudo-tela { text-align: center; padding: 50px; font-family: sans-serif; }
  .documento-oficial, .secao-relatorio { display: none; }

  /* Elementos de estilização da interface web */
  .seletor-relatorio {
    padding: 12px 20px;
    font-size: 15px;
    border: 2px solid #D71920;
    border-radius: 8px;
    font-weight: bold;
    color: #333;
    background-color: white;
    outline: none;
    cursor: pointer;
    margin-right: 10px;
    min-width: 280px;
  }

  /* --- ESTILO PARA O RELATÓRIO (Impressão/PDF) --- */
  @media print {
    header, nav, .navbar, .conteudo-tela, .no-print, button, a, select { display: none !important; }
    
    .documento-oficial { 
      display: block !important; 
      font-family: "Courier New", Courier, monospace; 
      color: black; 
    }

    /* O JavaScript vai adicionar a classe 'ativo-print' na seção selecionada */
    .secao-relatorio.ativo-print {
      display: block !important;
    }

    body { background: white !important; }

    /* CORREÇÃO DAS BORDAS APAGADAS AQUI */
    table { 
      width: 100%; 
      border-collapse: separate; 
      border-spacing: 0; 
      margin-top: 15px; 
      margin-bottom: 30px;
      border: 2px solid #000000 !important; 
      -webkit-print-color-adjust: exact; 
      print-color-adjust: exact;
    }

    th, td { 
      border-bottom: 1px solid #000000 !important; 
      border-right: 1px solid #000000 !important; 
      padding: 8px; 
      text-align: left; 
      font-size: 12px; 
      color: black !important;
    }

    /* Remove a borda direita da última coluna para não cortar o traço da tabela */
    th:last-child, td:last-child {
      border-right: none !important;
    }

    /* Remove a borda inferior da última linha para o fechamento ficar perfeito */
    tr:last-child td {
      border-bottom: none !important;
    }

    th { 
      background-color: #ddd !important; 
      text-transform: uppercase;
      font-weight: bold;
    }
    
    h1 { font-size: 18px; border-bottom: 2px solid black; padding-bottom: 5px; margin-top: 20px; text-align: center; }
    h2 { font-size: 15px; margin-top: 20px; text-decoration: underline; text-transform: uppercase; }
    .resumo-bloco { border: 1.5px dashed black; padding: 15px; margin-bottom: 20px; font-size: 13px; }
  }
</style>

<div class="conteudo-tela">
  <div style="background: #f8f9fa; padding: 40px; border-radius: 15px; border: 1px solid #ddd; max-width: 700px; margin: 0 auto;">
    <h2 style="color: #333; text-decoration: none;">Gerador Central de Relatórios Oficiais</h2>
    <p style="color: #666; margin-bottom: 25px;">Selecione o tipo de relatório que deseja exportar em formato técnico (PDF).</p>
    
    <div style="display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap;">
      <select id="tipoRelatorio" class="seletor-relatorio">
        <option value="estoque">Reposição de Estoque</option>
        <option value="fluxo_caixa">Fluxo de Caixa Detalhado</option>
        <option value="despesas">Despesas a Pagar (Pendentes)</option>
        <option value="faturamento">Resumo do Faturamento Total</option>
        <option value="auditoria">Auditoria e Histórico de Ações</option>
      </select>

      <button onclick="dispararImpressao()" style="background: #D71920; color: #fff; padding: 13px 30px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">
           GERAR PDF
      </button>
    </div>
  </div>

  <div style="margin-top: 30px; text-align: center;">
  <%= link_to "← Voltar ao Painel", root_path, style: "color: #0000FF; text-decoration: underline; font-family: sans-serif; font-weight: bold; font-size: 0.9em;" %>
  </div>
</div>

<div class="documento-oficial">
  
  <div style="text-align: center; margin-bottom: 20px;">
    <p><strong>CANTINAS E LANCHONETE QUERO LANCHES</strong> - UNIDADES MATRIZ E IF BAIANO CATU</p>
    <p>EMISSÃO: <%= Time.current.strftime("%d/%m/%Y - %H:%M") %></p>
  </div>

  <%# ==================== 1. RELATÓRIO DE ESTOQUE (ATUALIZADO COM UNIDADE DE MEDIDA) ==================== %>
  <div id="relatorio-estoque" class="secao-relatorio">
    <h1>RELATÓRIO TÉCNICO DE REPOSIÇÃO DE ESTOQUE</h1>
    
    <% matriz_alerta = @produtos_para_comprar.select(&:estoque_centro_baixo?) %>
    <% if matriz_alerta.any? %>
      <h2>UNIDADE: MATRIZ CENTRO</h2>
      <table>
        <thead>
          <tr><th>PRODUTO</th><th>ESTOQUE ATUAL</th><th>LIMITE MÍNIMO</th></tr>
        </thead>
        <tbody>
          <% matriz_alerta.each do |p| %>
            <%# Captura e trata a unidade de medida da matriz %>
            <% 
              unidade_p = p.respond_to?(:unidade_medida) ? p.unidade_medida.to_s.downcase.strip : "unidade"
              
              estoque_num = p.estoque_centro.to_f
              limite_num = p.limite_centro.to_f

              estoque_formatado = estoque_num == estoque_num.to_i ? estoque_num.to_i.to_s : sprintf("%.2f", estoque_num).gsub('.', ',')
              limite_formatado = limite_num == limite_num.to_i ? limite_num.to_i.to_s : sprintf("%.2f", limite_num).gsub('.', ',')

              unidade_estoque = unidade_p
              if estoque_num > 1
                unidade_estoque = case unidade_p
                                 when "unidade" then "unidades" when "fatia" then "fatias" when "rodela" then "rodelas"
                                 when "folha" then "folhas" when "litro" then "litros" when "quilo" then "quilos"
                                 when "un" then "un" when "kg" then "kg" when "ml" then "ml"
                                 else unidade_p.end_with?('s') ? unidade_p : "#{unidade_p}s" end
              end

              unidade_limite = unidade_p
              if limite_num > 1
                unidade_limite = case unidade_p
                                 when "unidade" then "unidades" when "fatia" then "fatias" when "rodela" then "rodelas"
                                 when "folha" then "folhas" when "litro" then "litros" when "quilo" then "quilos"
                                 when "un" then "un" when "kg" then "kg" when "ml" then "ml"
                                 else unidade_p.end_with?('s') ? unidade_p : "#{unidade_p}s" end
              end
            %>
            <tr>
              <td><%= p.nome.upcase %></td>
              <td><%= "#{estoque_formatado} #{unidade_estoque}" %></td>
              <td><%= "#{limite_formatado} #{unidade_limite}" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% pav_novo_alerta = @produtos_para_comprar.select(&:estoque_pavilhao_novo_baixo?) %>
    <% if pav_novo_alerta.any? %>
      <h2>UNIDADE: PAVILHÃO NOVO</h2>
      <table>
        <thead>
          <tr><th>PRODUTO</th><th>ESTOQUE ATUAL</th><th>LIMITE MÍNIMO</th></tr>
        </thead>
        <tbody>
          <% pav_novo_alerta.each do |p| %>
            <%# Captura e trata a unidade de medida do pavilhão novo %>
            <% 
              unidade_p = p.respond_to?(:unidade_medida) ? p.unidade_medida.to_s.downcase.strip : "unidade"
              
              estoque_num = p.estoque_pavilhao_novo.to_f
              limite_num = p.limite_pavilhao_novo.to_f

              estoque_formatado = estoque_num == estoque_num.to_i ? estoque_num.to_i.to_s : sprintf("%.2f", estoque_num).gsub('.', ',')
              limite_formatado = limite_num == limite_num.to_i ? limite_num.to_i.to_s : sprintf("%.2f", limite_num).gsub('.', ',')

              unidade_estoque = unidade_p
              if estoque_num > 1
                unidade_estoque = case unidade_p
                                 when "unidade" then "unidades" when "fatia" then "fatias" when "rodela" then "rodelas"
                                 when "folha" then "folhas" when "litro" then "litros" when "quilo" then "quilos"
                                 when "un" then "un" when "kg" then "kg" when "ml" then "ml"
                                 else unidade_p.end_with?('s') ? unidade_p : "#{unidade_p}s" end
              end

              unidade_limite = unidade_p
              if limite_num > 1
                unidade_limite = case unidade_p
                                 when "unidade" then "unidades" when "fatia" then "fatias" when "rodela" then "rodelas"
                                 when "folha" then "folhas" when "litro" then "litros" when "quilo" then "quilos"
                                 when "un" then "un" when "kg" then "kg" when "ml" then "ml"
                                 else unidade_p.end_with?('s') ? unidade_p : "#{unidade_p}s" end
              end
            %>
            <tr>
              <td><%= p.nome.upcase %></td>
              <td><%= "#{estoque_formatado} #{unidade_estoque}" %></td>
              <td><%= "#{limite_formatado} #{unidade_limite}" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# ==================== 2. RELATÓRIO DE FLUXO DE CAIXA ==================== %>
  <div id="relatorio-fluxo_caixa" class="secao-relatorio">
    <h1>RELATÓRIO DETALHADO DO FLUXO DE CAIXA</h1>
    
    <div class="resumo-bloco">
      <strong>EXTRATO CONSOLIDADO ATUAL:</strong><br>
      (+) Total Entrada (Vendas): <span style="color: green !important; font-weight: bold;"><%= number_to_currency(@total_vendas, unit: "R$ ", separator: ",", delimiter: ".") %></span><br>
      (-) Total Saída (Despesas Pagas): <span style="color: red !important; font-weight: bold;"><%= number_to_currency(@total_despesas, unit: "R$ ", separator: ",", delimiter: ".") %></span><br>
      
      <strong>
        (=) Saldo de Caixa Líquido: 
        <% if @lucro_liquido >= 0 %>
          <span style="color: #0000FF !important; font-weight: bold;"><%= number_to_currency(@lucro_liquido, unit: "R$ ", separator: ",", delimiter: ".") %></span>
        <% else %>
          <span style="color: #D71920 !important; font-weight: bold;"><%= number_to_currency(@lucro_liquido, unit: "R$ ", separator: ",", delimiter: ".") %></span>
        <% end %>
      </strong>
    </div>

    <h2>ÚLTIMAS ENTRADAS REGISTRADAS (VENDAS)</h2>
    <table>
      <thead>
        <tr>
          <th>DATA/HORA</th>
          <th>PEDIDO ID</th>
          <th>UNIDADE</th>
          <th>STATUS</th>
          <th>VALOR TOTAL</th>
        </tr>
      </thead>
      <tbody>
        <% @pedidos_recentes.each do |p| %>
          <tr>
            <td><%= p.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td>#<%= p.id %></td>
            <td><%= p.unidade&.upcase %></td>
            <td><%= p.respond_to?(:metodo_pagamento) ? p.metodo_pagamento&.upcase : "CONCLUÍDO" %></td>
            <td style="color: green !important; font-weight: bold;"><%= number_to_currency(p.valor_total, unit: "R$ ", separator: ",", delimiter: ".") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h2>ÚLTIMAS SAÍDAS REGISTRADAS (DESPESAS PAGAS)</h2>
    <table>
      <thead>
        <tr>
          <th>DATA PAGAMENTO</th>
          <th>DESCRIÇÃO/FORNECEDOR</th>
          <th>CATEGORIA</th>
          <th>UNIDADE</th>
          <th>VALOR SAÍDA</th>
        </tr>
      </thead>
      <tbody>
        <% if @despesas_pagas_detalhado.any? %>
          <% @despesas_pagas_detalhado.each do |d| %>
            <tr>
              <td><%= d.data_pagamento&.strftime("%d/%m/%Y") || d.updated_at.strftime("%d/%m/%Y") %></td>
              <td><%= d.descricao.upcase %></td>
              <td><%= d.categoria&.upcase %></td>
              <td><%= d.unidade&.upcase %></td>
              <td style="color: red !important; font-weight: bold;">- <%= number_to_currency(d.valor, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" style="text-align: center;">Nenhuma despesa paga registrada no período.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ==================== 3. RELATÓRIO DE DESPESAS A PAGAR ==================== %>
  <div id="relatorio-despesas" class="secao-relatorio">
    <h1>RELATÓRIO DE DESPESAS ACUMULADAS A PAGAR</h1>
    
    <% if @despesas_a_pagar.any? %>
      <table>
        <thead>
          <tr><th>VENCIMENTO</th><th>DESCRIÇÃO/FORNECEDOR</th><th>CATEGORIA</th><th>VALOR</th></tr>
        </thead>
        <tbody>
          <% @despesas_a_pagar.each do |d| %>
            <tr>
              <td><%= d.data_vencimento&.strftime("%d/%m/%Y") || "N/A" %></td>
              <td><%= d.descricao.upcase %></td>
              <td><%= d.categoria.present? ? d.categoria.upcase : "GERAL" %></td>
              <td><%= number_to_currency(d.valor, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p style="text-align: center; margin-top: 30px;">Nenhuma despesa pendente registrada até o momento.</p>
    <% end %>
  </div>

  <%# ==================== 4. RELATÓRIO DE FATURAMENTO ==================== %>
  <div id="relatorio-faturamento" class="secao-relatorio">
    <h1>RELATÓRIO CONSOLIDADO DE FATURAMENTO</h1>
    
    <table style="margin-top: 30px;">
      <thead>
        <tr><th style="width: 70%;">INDICADOR FINANCEIRO PERÍODO TOTAL</th><th>VALOR</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>FATURAMENTO BRUTO (+)</strong> (Total bruto arrecadado em vendas de lanches)</td>
          <td style="color: green !important; font-weight: bold;"><%= number_to_currency(@total_vendas, unit: "R$ ", separator: ",", delimiter: ".") %></td>
        </tr>
        <tr>
          <td><strong>DESPESAS OPERACIONAIS (-)</strong> (Custos pagos com insumos e infraestrutura)</td>
          <td style="color: red !important;"><%= number_to_currency(@total_despesas, unit: "R$ ", separator: ",", delimiter: ".") %></td>
        </tr>
        <tr style="background-color: #eee !important;">
          <td><strong>LUCRO LÍQUIDO CONSOLIDADO (=)</strong></td>
          <td style="font-weight: bold;">
            <% if @lucro_liquido >= 0 %>
              <span style="color: #0000FF !important;"><%= number_to_currency(@lucro_liquido, unit: "R$ ", separator: ",", delimiter: ".") %></span>
            <% else %>
              <span style="color: #D71920 !important;"><%= number_to_currency(@lucro_liquido, unit: "R$ ", separator: ",", delimiter: ".") %></span>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <%# ==================== 5. RELATÓRIO DE AUDITORIA ==================== %>
  <div id="relatorio-auditoria" class="secao-relatorio">
    <h1>RELATÓRIO DE AUDITORIA E MOVIMENTAÇÕES DE ESTOQUE</h1>
    
    <table>
      <thead>
        <tr>
          <th>DATA/HORA</th>
          <th>RESPONSÁVEL</th>
          <th>UNIDADE</th>
          <th>ITEM</th>
          <th>AÇÃO</th>
          <th>QTD</th>
        </tr>
      </thead>
      <tbody>
        <% @movimentacoes.each do |log| %>
          <tr>
            <td><%= log.created_at.strftime("%d/%m/%y %H:%M") %></td>
            <td><%= log.respond_to?(:responsavel) ? log.responsavel : (log.funcionario&.nome || "Sistema") %></td>
            <td><%= log.unidade&.upcase %></td>
            <td><%= log.respond_to?(:produto_nome) ? log.produto_nome : log.produto&.nome %></td>
            <td><%= log.respond_to?(:acao) ? log.acao.to_s.upcase : log.tipo_movimentacao.to_s.upcase %></td>
            
            <td style="font-weight: bold;">
              <% 
                qtd_numerica = log.respond_to?(:qtd) ? log.qtd.to_f : log.quantidade.to_f
                produto_log = log.produto
                unidade_medida = produto_log&.respond_to?(:unidade_medida) ? produto_log.unidade_medida.to_s.downcase.strip : "unidade"
                nome_prod = produto_log&.nome.to_s.downcase
                tipo_mov = log.respond_to?(:acao) ? log.acao.to_s.upcase : log.tipo_movimentacao.to_s.upcase

                if tipo_mov.include?('SAÍDA') && produto_log
                  comp_como_insumo = Composicao.find_by(insumo_id: produto_log.id)
                  if comp_como_insumo && comp_como_insumo.unidade_medida_uso.present?
                    unidade_medida = comp_como_insumo.unidade_medida_uso.to_s.downcase.strip
                  elsif unidade_medida == 'litro' && (nome_prod.include?('suco') || nome_prod.include?('vitamina') || nome_prod.include?('café') || nome_prod.include?('cafe'))
                    if qtd_numerica < 1.0 && qtd_numerica > 0
                      qtd_numerica = (qtd_numerica * 1000).round(0)
                      unidade_medida = "ml"
                    end
                  end
                end

                qtd_formatada = qtd_numerica == qtd_numerica.to_i ? qtd_numerica.to_i.to_s : sprintf("%.2f", qtd_numerica).gsub('.', ',')
                
                if qtd_numerica > 1
                  unidade_medida = case unidade_medida
                                   when "unidade" then "unidades"
                                   when "fatia"   then "fatias"
                                   when "rodela"  then "rodelas"
                                   when "folha"   then "folhas"
                                   when "litro"   then "litros"
                                   when "quilo"   then "quilos"
                                   when "un"      then "un"
                                   when "kg"      then "kg"
                                   when "ml"      then "ml"
                                   else 
                                     unidade_medida.end_with?('s') ? unidade_medida : "#{unidade_medida}s"
                                   end
                end
              %>
              <%= "#{qtd_formatada} #{unidade_medida}" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="margin-top: 60px; border-top: 2px solid black; width: 350px; text-align: center; margin-left: auto; margin-right: auto;">
    <p>Responsável pela Conferência</p>
    <p style="font-size: 10px;">Sistema Cantina Quero Lanches - Catu/BA</p>
  </div>
</div>

<script>
  function dispararImpressao() {
    var seletor = document.getElementById("tipoRelatorio");
    var tipoSelecionado = seletor.value;
    
    var secoes = document.getElementsByClassName("secao-relatorio");
    for (var i = 0; i < secoes.length; i++) {
      secoes[i].classList.remove("ativo-print");
    }
    
    var secaoAlvo = document.getElementById("relatorio-" + tipoSelecionado);
    if (secaoAlvo) {
      secaoAlvo.classList.add("ativo-print");
      window.print();
    }
  }
</script>