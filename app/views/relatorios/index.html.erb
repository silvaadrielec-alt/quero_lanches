<style>
  /* --- ESTILO PARA A TELA (Navegação) --- */
  .conteudo-tela { text-align: center; padding: 50px; font-family: sans-serif; }
  .documento-oficial { display: none; }

  /* --- ESTILO PARA O RELATÓRIO (Impressão/PDF) --- */
  @media print {
    header, nav, .navbar, .conteudo-tela, .no-print, button, a { display: none !important; }
    
    .documento-oficial { 
      display: block !important; 
      font-family: "Courier New", Courier, monospace; 
      color: black; 
    }

    body { background: white !important; }

    /* Força as bordas a ficarem bem pretas e nítidas */
    table { 
      width: 100%; 
      border-collapse: collapse; 
      margin-top: 10px; 
      margin-bottom: 30px;
      border: 2px solid black !important; /* Borda externa forte */
    }

    th, td { 
      border: 1.5px solid black !important; /* Borda interna nítida */
      padding: 8px; 
      text-align: left; 
      font-size: 12px; 
      color: black !important;
    }

    th { 
      background-color: #ddd !important; 
      text-transform: uppercase;
      font-weight: bold;
    }
    
    h1 { font-size: 18px; border-bottom: 2px solid black; padding-bottom: 5px; margin-top: 20px; }
    h2 { font-size: 16px; margin-top: 20px; text-decoration: underline; }

    /* Quebra de página opcional entre unidades se a tabela for muito grande */
    .quebra-pagina { page-break-before: always; }
  }
</style>

<!-- O QUE APARECE NA TELA -->
<div class="conteudo-tela">
  <div style="background: #f8f9fa; padding: 40px; border-radius: 15px; border: 1px solid #ddd;">
    <h2 style="color: #333;">Gerador de Relatórios Técnicos</h2>
    <p style="color: #666;">Selecione a opção de impressão da <strong>Cantina Quero Lanches</strong>.</p>
    
    <button onclick="window.print()" style="background: #000; color: #fff; padding: 15px 30px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; margin-top: 20px;">
      📄 GERAR RELATÓRIO POR UNIDADES (PDF)
    </button>
  </div>

  <div style="margin-top: 20px;">
    <%= link_to "← Voltar ao Painel", root_path, style: "color: #666; text-decoration: none;" %>
  </div>
</div>

<!-- O QUE APARECE NO RELATÓRIO (Documento de Saída) -->
<div class="documento-oficial">
  <div style="text-align: center;">
    <h1>RELATÓRIO TÉCNICO DE REPOSIÇÃO DE ESTOQUE</h1>
    <p><strong>CANTINAS E LANCHONETE QUERO LANCHES</strong> - UNIDADES MATRIZ E IF BAIANO CATU</p>
    <p>EMISSÃO: <%= Time.current.strftime("%d/%m/%Y - %H:%M") %></p>
  </div>

  <%# --- SEÇÃO MATRIZ --- %>
  <% matriz_alerta = @produtos_para_comprar.select(&:estoque_centro_baixo?) %>
  <% if matriz_alerta.any? %>
    <h2>UNIDADE: MATRIZ CENTRO</h2>
    <table>
      <thead>
        <tr>
          <th>PRODUTO</th>
          <th>ESTOQUE ATUAL</th>
          <th>LIMITE MÍNIMO</th>
        </tr>
      </thead>
      <tbody>
        <% matriz_alerta.each do |p| %>
          <tr>
            <td><%= p.nome.upcase %></td>
            <td><%= p.estoque_centro %></td>
            <td><%= p.limite_centro %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%# --- SEÇÃO PAVILHÃO NOVO --- %>
  <% pav_novo_alerta = @produtos_para_comprar.select(&:estoque_pavilhao_novo_baixo?) %>
  <% if pav_novo_alerta.any? %>
    <h2>UNIDADE: PAVILHÃO NOVO</h2>
    <table>
      <thead>
        <tr>
          <th>PRODUTO</th>
          <th>ESTOQUE ATUAL</th>
          <th>LIMITE MÍNIMO</th>
        </tr>
      </thead>
      <tbody>
        <% pav_novo_alerta.each do |p| %>
          <tr>
            <td><%= p.nome.upcase %></td>
            <td><%= p.estoque_pavilhao_novo %></td>
            <td><%= p.limite_pavilhao_novo %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%# --- SEÇÃO PAVILHÃO ANTIGO --- %>
  <% pav_antigo_alerta = @produtos_para_comprar.select(&:estoque_pavilhao_antigo_baixo?) %>
  <% if pav_antigo_alerta.any? %>
    <h2>UNIDADE: PAVILHÃO ANTIGO</h2>
    <table>
      <thead>
        <tr>
          <th>PRODUTO</th>
          <th>ESTOQUE ATUAL</th>
          <th>LIMITE MÍNIMO</th>
        </tr>
      </thead>
      <tbody>
        <% pav_antigo_alerta.each do |p| %>
          <tr>
            <td><%= p.nome.upcase %></td>
            <td><%= p.estoque_pavilhao_antigo %></td>
            <td><%= p.limite_pavilhao_antigo %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div style="margin-top: 50px; border-top: 2px solid black; width: 350px; text-align: center; margin-left: auto; margin-right: auto;">
    <p>Responsável pela Conferência</p>
  </div>
</div>