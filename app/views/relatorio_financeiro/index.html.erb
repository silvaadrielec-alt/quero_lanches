<div style="max-width: 1200px; margin: 40px auto; font-family: sans-serif; box-sizing: border-box; padding: 0 20px;">
  
  <%# --- 1. BOTÃO VOLTAR --- %>
  <div style="text-align: left; margin-bottom: 20px;">
    <%= link_to auditorias_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;" do %>
      ← VOLTAR PARA AUDITORIA
    <% end %>
  </div>

  <%# --- 2. CABEÇALHO --- %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; width: 100%;">
    <h1 style="color: #D71920; font-size: 2.2em; margin: 0; font-weight: bold; letter-spacing: 0.5px;">Resumo Financeiro do Estoque</h1>
  </div>

  <%# --- 3. PAINEL DE FILTROS (PADRÃO DESPESAS) --- %>
  
  <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 25px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
  <%= form_with url: relatorio_financeiro_index_path, method: :get, local: true, style: "margin: 0;" do |f| %>
    
    <%# Usamos flexbox simples com itens alinhados ao topo para manter o padrão visual %>
    <div style="display: flex; gap: 15px; align-items: flex-start; flex-wrap: wrap;">

      <%# UNIDADE %>
      <div style="flex: 2; min-width: 250px;">
        <label style="display: block; font-size: 10px; font-weight: bold; color: #64748b; margin-bottom: 4px; text-transform: uppercase;">UNIDADE / PONTO</label>
        <%= f.collection_select :unidade_id, Unidade.all, :id, :nome, 
            { include_blank: "GERAL (TODAS)", selected: params[:unidade_id] }, 
            { style: "width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; height: 38px; box-sizing: border-box;" } %>
      </div>

      <%# DATAS %>
      <div style="flex: 1; min-width: 140px;">
        <label style="display: block; font-size: 10px; font-weight: bold; color: #64748b; margin-bottom: 4px; text-transform: uppercase;">DATA INICIAL</label>
        <%= f.date_field :data_inicio, value: @data_inicio, style: "width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; height: 38px; box-sizing: border-box;" %>
      </div>

      <div style="flex: 1; min-width: 140px;">
        <label style="display: block; font-size: 10px; font-weight: bold; color: #64748b; margin-bottom: 4px; text-transform: uppercase;">DATA FINAL</label>
        <%= f.date_field :data_fim, value: @data_fim, style: "width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; height: 38px; box-sizing: border-box;" %>
      </div>

      <%# BOTÕES %>
      <div style="display: flex; gap: 8px; align-self: flex-end; height: 38px;">
        <%= f.submit "FILTRAR", style: "background: #D71920; color: white; border: none; padding: 0 16px; border-radius: 6px; font-weight: bold; height: 38px; font-size: 11px; text-transform: uppercase; cursor: pointer;" %>
        <%= link_to "LIMPAR", relatorio_financeiro_index_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 0 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; text-transform: uppercase; height: 38px; display: flex; align-items: center;" %>
      </div>

    </div>
  <% end %>
</div>

  <%# --- 4. CARDS DE RESUMO (MANTIDO) --- %>
  <div style="display: flex; gap: 20px; margin-bottom: 30px;">
    <% [{t: "Total Custo (Saída $)", v: @total_custo, c: "#d9534f", b: "#fff8f8"}, {t: "Total Receita (Entrada $)", v: @total_receita, c: "#5cb85c", b: "#f8fff8"}, {t: "Lucro Bruto", v: @lucro_bruto, c: "#0275d8", b: "#f0f7ff"}].each do |card| %>
      <div style="padding: 20px; border: 1px solid #ddd; border-radius: 8px; background: <%= card[:b] %>; flex: 1;">
        <strong><%= card[:t] %></strong><br>
        <span style="color: <%= card[:c] %>; font-size: 24px;"><%= number_to_currency(card[:v]) %></span>
      </div>
    <% end %>
  </div>

  <%# --- 5. TABELA (ESTILIZADA) --- %>
  <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #D71920;">
    <table style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr style="background-color: #D71920; color: white; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
      <th style="padding: 12px; width: 15%; text-align: left; border-top-left-radius: 6px;">Data/Hora</th>
      <th style="padding: 12px; width: 15%; text-align: left;">Unidade</th>
      <th style="padding: 12px; width: 30%; text-align: left;">Item</th>
      <th style="padding: 12px; width: 15%; text-align: left;">Tipo</th>
      <th style="padding: 12px; width: 12%; text-align: right;">Custo</th>
      <th style="padding: 12px; width: 13%; text-align: right; border-top-right-radius: 6px;">Receita</th>
    </tr>
  </thead>
  <tbody>
    <% @movimentacoes.each do |mov| %>
      <tr style="border-bottom: 1px solid #f1f5f9; font-size: 14px; color: #1e293b;">
        <td style="padding: 12px;"><%= mov.created_at.strftime("%d/%m/%Y %H:%M") %></td>
        <td style="padding: 12px;"><%= mov.unidade&.nome || "---" %></td>
        <td style="padding: 12px;"><%= mov.produto&.nome || mov.insumo&.nome %></td>
        <td style="padding: 12px;"><%= mov.tipo_movimentacao.upcase %></td>
        <td style="padding: 12px; text-align: right;"><%= number_to_currency(mov.valor_custo) %></td>
        <td style="padding: 12px; text-align: right;"><%= number_to_currency(mov.valor_receita) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
  </div>
</div>