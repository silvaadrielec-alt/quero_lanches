<%= form_with(model: produto, id: "form-produto-principal") do |form| %>
  
  <%# EXIBIÇÃO DE ERROS NO PADRÃO TONAL PREMIUM %>
  <% if produto.errors.any? %>
    <div style="color: #dc2626; background: #fef2f2; padding: 18px; border-radius: 8px; margin-bottom: 25px; border: 1px solid #fee2e2; text-align: left; box-sizing: border-box; font-family: sans-serif; font-size: 14px;">
      <h2 style="font-size: 15px; font-weight: bold; margin-top: 0; text-transform: uppercase; letter-spacing: 0.3px;">
        <%= produto.errors.count %> <%= produto.errors.count > 1 ? "erros impediram" : "erro impediu" %> de salvar o produto:
      </h2>
      <ul style="margin: 8px 0 0 0; padding-left: 20px; color: #b91c1c; line-height: 1.4;">
        <% produto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Força a categoria a ser sempre Venda de forma oculta %>
  <%= form.hidden_field :categoria, value: "Venda" %>

  <%#  ORIENTAÇÃO DE CADASTRO OPERACIONAL %>
  <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; padding: 15px 18px; border-radius: 8px; margin-bottom: 25px; text-align: left; box-sizing: border-box;">
    <strong style="color: #14532d; font-size: 13px; display: block; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 4px;">
        O QUE CADASTRAR NESTA TELA?
    </strong>
    <p style="margin: 0; font-size: 12px; color: #166534; font-style: italic; font-weight: 500; line-height: 1.4;">
      Cadastre aqui **apenas itens de revenda direta** que entram acabados no estoque (ex: Coca-Cola Lata 350ml, Coca-Cola 600ml, Picolé, Salgadinho). Cada variação de tamanho deve ser um cadastro individual para controle preciso de saldo e código.
    </p>
  </div>

  <%# GRID 1: Código e Unidade de Medida lado a lado %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px 30px; margin-bottom: 20px; text-align: left; width: 100%; box-sizing: border-box;">
    <div style="display: flex; flex-direction: column;">
      <%= form.label :codigo, "Código do Produto", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= form.text_field :codigo, 
          placeholder: "Deixe em branco para gerar automático", 
          style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
    </div>

    <div style="display: flex; flex-direction: column;">
      <%= form.label :unidade_medida, "Unidade de Medida", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= form.select :unidade_medida, 
          ['unidade', 'fatia', 'porção', 'kg', 'litro', 'ml'], 
          { prompt: 'Como este item é vendido?' }, 
          { style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; height: 41px; background: #fff; box-sizing: border-box; color: #1e293b;" } %>
    </div>
  </div>

  <%# NOME DO PRODUTO %>
  <div style="margin-bottom: 20px; text-align: left; display: flex; flex-direction: column; box-sizing: border-box;">
    <%= form.label :nome, "Nome do Produto", style: "font-size: 11px; font-weight: bold; color: #D71920; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;" %>
    <%= form.text_field :nome, placeholder: "Ex: Coca-Cola Lata 350ml, Suco Prats Laranja 900ml", style: "width: 100%; padding: 11px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; color: #1e293b; font-weight: 500;" %>
  </div>

  <%# GRID 2: Valores Financeiros %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px 30px; margin-bottom: 30px; text-align: left; width: 100%; box-sizing: border-box;">
    <div style="background-color: #fff7ed; padding: 15px 18px; border-radius: 8px; border: 1px solid #ffedd5; box-sizing: border-box; border-left: 4px solid #ea580c;">
      <%= form.label :valor_unitario, "Custo de Compra (R$)", style: "display: block; font-weight: bold; margin-bottom: 6px; color: #c2410c; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= form.number_field :valor_unitario, 
          step: 0.01, 
          value: form.object.valor_unitario.present? ? sprintf("%.2f", form.object.valor_unitario) : "", 
          placeholder: "0,00",
          style: "width: 100%; padding: 10px 14px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background: #fff; color: #1e293b; font-weight: bold;" %>
    </div>

    <div style="background-color: #f0f9ff; padding: 15px 18px; border-radius: 8px; border: 1px solid #e0f2fe; box-sizing: border-box; border-left: 4px solid #0284c7;">
      <%= form.label :preco_venda, "Preço de Venda Praticado (R$)", style: "display: block; font-weight: bold; margin-bottom: 6px; color: #0369a1; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px;" %>
      <%= form.number_field :preco_venda, 
          step: 0.01, 
          value: form.object.preco_venda.present? ? sprintf("%.2f", form.object.preco_venda) : "", 
          placeholder: "0,00",
          style: "width: 100%; padding: 10px 14px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; box-sizing: border-box; background: #fff; color: #1e293b; font-weight: bold;" %>
    </div>
  </div>

<%# 🌟 CONFIGURAÇÃO DE CONTROLE DE ESTOQUE %>
<div style="margin-bottom: 25px; background: #e0f2fe; padding: 18px; border-radius: 8px; border: 1px solid #bae6fd; text-align: left; box-sizing: border-box;">
  <label style="display: flex; align-items: center; gap: 14px; font-weight: bold; color: #0369a1; cursor: pointer; margin: 0;">
    <%= form.check_box :estoque_controlado, checked: true, style: "width: 20px; height: 20px; cursor: pointer; accent-color: #0369a1;" %>
    <span style="font-size: 14px; text-transform: uppercase; letter-spacing: 0.3px;">ATIVAR CONTROLE DE ESTOQUE FÍSICO</span>
  </label>
</div>

<%# 🌟 CONFIGURAÇÃO DE ALERTA DE ESTOQUE (LIMITES MÍNIMOS) %>
  <div style="background-color: #fafafa; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 30px; text-align: left;">
    <h3 style="color: #1e293b; font-size: 14px; margin-top: 0; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 0.5px;">
      ⚠️ Limites para Alerta de Reposição
    </h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px;">
      
      <div style="display: flex; flex-direction: column;">
        <%= form.label :limite_centro, "Limite Centro", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 5px;" %>
        <%= form.number_field :limite_centro, step: 0.001, style: "padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; font-weight: bold;" %>
      </div>

      <div style="display: flex; flex-direction: column;">
        <%= form.label :limite_pavilhao_novo, "Limite Pav. Novo", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 5px;" %>
        <%= form.number_field :limite_pavilhao_novo, step: 0.001, style: "padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; font-weight: bold;" %>
      </div>

      <div style="display: flex; flex-direction: column;">
        <%= form.label :limite_pavilhao_antigo, "Limite Pav. Antigo", style: "font-size: 11px; font-weight: bold; color: #64748b; margin-bottom: 5px;" %>
        <%= form.number_field :limite_pavilhao_antigo, step: 0.001, style: "padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; font-weight: bold;" %>
      </div>

    </div>
  </div>

  <%# BOTÃO DE SALVAR PRODUTO INDIVIDUAL %>
  <div style="text-align: center; box-sizing: border-box; width: 100%;">
    <%= form.submit "SALVAR DADOS DO PRODUTO", style: "background-color: #D71920; color: white; padding: 13px; cursor: pointer; border: none; width: 100%; font-weight: bold; border-radius: 8px; font-size: 14px; box-shadow: 0 4px 10px rgba(215,25,32,0.18); text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box;" %>
  </div>
<% end %>