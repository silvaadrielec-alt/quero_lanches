<%= form_with(model: produto) do |form| %>
  <% if produto.errors.any? %>
    <div style="color: red; margin-bottom: 20px; font-family: sans-serif;">
      <h2><%= produto.errors.count %> <%= produto.errors.count > 1 ? "erros impediram" : "erro impediu" %> de salvar:</h2>
      <ul>
        <% produto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# NOVO: CÓDIGO DO PRODUTO (MANUAL OU AUTOMÁTICO) %>
  <div style="margin-bottom: 20px;">
    <%= form.label :codigo, "Código do Produto / Insumo", style: "display: block; font-weight: bold; margin-bottom: 5px; color: #D71920;" %>
    <%= form.text_field :codigo, 
        placeholder: "Digite o código próprio ou deixe em BRANCO para gerar automaticamente", 
        style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
  </div>

  <%# 1. NOME %>
  <div style="margin-bottom: 20px;">
    <%= form.label :nome, "Nome do Produto/Insumo", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.text_field :nome, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
  </div>

  <%# 2. CATEGORIA %>
  <div style="margin-bottom: 20px;">
    <%= form.label :categoria, "Tipo do Item (Venda ou Insumo)", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.select :categoria, ["Venda", "Insumo"], { prompt: "Selecione o tipo" }, { id: "select-categoria", style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" } %>
  </div>

  <%# 3. UNIDADE DE MEDIDA %>
  <div style="margin-bottom: 20px;">
    <%= form.label :unidade_medida, "Unidade de Medida", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.select :unidade_medida, 
        ['unidade', 'fatia', 'folha', 'rodela', 'kg', 'litro', 'gramas', 'ml'], 
        { prompt: 'Como este item é contado?' }, 
        { style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" } %>
  </div>

  <%# MÉDIA POR KG (Exibido condicionalmente para Insumos) %>
  <div id="bloco-media" style="margin-bottom: 20px; background-color: #fcf3cf; padding: 10px; border-radius: 8px; border: 1px dashed #f39c12; display: none;">
    <%= form.label :media_unidades_kg, "Média do item por kg ou litro (Tradução)", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.number_field :media_unidades_kg, step: 0.01, placeholder: "Ex: 4.5 para laranjas ou 50 para fatias", style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
    <small style="color: #666;">Preencha apenas se o item for comprado em KG mas usado em unidade/fatia/rodela.</small>
  </div>

  <%# 4. VALOR DE CUSTO %>
  <div style="margin-bottom: 20px;">
    <%= form.label :valor_unitario, "Valor de Custo (Compra/Produção)", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.number_field :valor_unitario, step: 0.01, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
  </div>

  <%# 5. PREÇO DE VENDA %>
  <div style="margin-bottom: 30px;">
    <%= form.label :preco_venda, "Preço de Venda (Para o Cliente)", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.number_field :preco_venda, step: 0.01, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
  </div>

  <%# LIMITES %>
  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #D2B4DE; padding-bottom: 15px;">
    <div>
      <%= form.label :limite_centro, "Mínimo Matriz", style: "color: #7D3C98; font-weight: bold;" %>
      <%= form.number_field :limite_centro, class: "form-control" %>
    </div>
    <div>
      <%= form.label :limite_pavilhao_novo, "Mínimo Pav. Novo", style: "color: #7D3C98; font-weight: bold;" %>
      <%= form.number_field :limite_pavilhao_novo, class: "form-control" %>
    </div>
    <div>
      <%= form.label :limite_pavilhao_antigo, "Mínimo Pav. Antigo", style: "color: #7D3C98; font-weight: bold;" %>
      <%= form.number_field :limite_pavilhao_antigo, class: "form-control" %>
    </div>
  </div>

  <%# BOTÃO DE SALVAR %>
  <div style="text-align: center;">
    <%= form.submit "SALVAR DADOS DO PRODUTO", class: "btn-quero", style: "padding: 15px 40px; cursor: pointer; border: none; width: 100%; max-width: 400px; font-weight: bold;" %>
    
    <div style="margin-top: 25px;">
      <%= link_to "← VOLTAR PARA O CADASTRO", produtos_path, style: "color: #0000FF; text-decoration: underline; font-family: sans-serif;" %>
    </div>
  </div>
<% end %>

<script>
  function gerenciarCampoMedia() {
    const selectCategoria = document.getElementById("select-categoria");
    const blocoMedia = document.getElementById("bloco-media");

    if (selectCategoria && blocoMedia) {
      if (selectCategoria.value === "Insumo") {
        blocoMedia.style.display = "block";
      } else {
        blocoMedia.style.display = "none";
      }
    }
  }

  document.addEventListener("turbo:load", function() {
    const selectCategoria = document.getElementById("select-categoria");
    
    if (selectCategoria) {
      gerenciarCampoMedia();
      selectCategoria.addEventListener("change", gerenciarCampoMedia);
    }
  });

  document.addEventListener("DOMContentLoaded", gerenciarCampoMedia);
</script>