<% content_for :title, "Cadastrar Novo Produto" %>

<%# BARRA DE RETORNO SUPERIOR - ALINHADA AO CARD DE 800PX %>
<div style="max-width: 800px; margin: 30px auto 15px auto; padding: 0 20px; box-sizing: border-box; text-align: left; font-family: sans-serif;">
  <%= link_to produtos_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;" do %>
    ← VOLTAR PARA LISTAGEM
  <% end %>
</div>

<%# CARD PRINCIPAL COM A MOLDURA VERMELHA OFICIAL %>
<div style="max-width: 800px; margin: 0 auto 40px auto; padding: 0 20px; font-family: sans-serif; box-sizing: border-box;">
  <div class="card-principal" style="padding: 35px; border-radius: 12px; background: #fff; border: 2px solid #D71920 !important; box-shadow: 0 4px 15px rgba(0,0,0,0.05); box-sizing: border-box;">
    <h1 style="color: #D71920; margin-top: 0; margin-bottom: 30px; text-align: center; font-weight: bold; font-size: 2em; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px; letter-spacing: 0.5px;">
      Cadastrar Novo Produto
    </h1>

    <%= render "form", produto: @produto %>
  </div>
</div>

