<p style="color: green"><%= notice %></p>

<div class="container-estoque" style="max-width: 900px; margin: 0 auto; padding: 20px;">
  
  <%# Renderiza o partial com o Nome e dados principais do item %>
  <%= render @produto %>

  <div style="margin-top: 20px;">
    <% if current_funcionario.admin? %>
      <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <%= link_to "← Voltar para Produtos", produtos_path, style: "color: #0000FF; text-decoration: underline; font-family: sans-serif; font-weight: bold;" %>
        <%= link_to 'Editar este produto', edit_produto_path(@produto), style: "color: #0000FF; text-decoration: underline; font-family: sans-serif;" %>
      </div>
      
      <%# --- PAINEL DE QUANTIDADES EM ESTOQUE POR UNIDADE --- %>
      <h3 style="color: #7D3C98; font-weight: bold; font-family: sans-serif; margin-bottom: 15px; border-bottom: 2px solid #7D3C98; padding-bottom: 5px; text-align: left;">Quantidade em Estoque nas Unidades</h3>
      <div style="display: flex; gap: 15px; margin: 15px 0 30px 0; flex-wrap: wrap; text-align: left;">
        
        <%# MATRIZ CENTRO %>
        <div style="flex: 1; min-width: 180px; background: #fdf2e9; padding: 15px; border-radius: 12px; border-left: 6px solid #e67e22; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
          <span style="color: #666; font-size: 0.8em; font-weight: bold; text-transform: uppercase;">Mínimo Matriz: <%= @produto.limite_centro.to_f %></span>
          <h4 style="margin: 5px 0 2px 0; color: #333; font-size: 1.1em;">Matriz Centro</h4>
          <strong style="font-size: 1.8em; color: <%= @produto.estoque_centro_baixo? ? '#D71920' : '#e67e22' %>;">
            <%= @produto.estoque_centro.to_f %> <span style="font-size: 0.5em;"><%= @produto.unidade_medida %></span>
          </strong>
          <%= "⚠️ Reposição" if @produto.estoque_centro_baixo? %>
        </div>

        <%# PAVILHÃO NOVO %>
        <div style="flex: 1; min-width: 180px; background: #f5eef8; padding: 15px; border-radius: 12px; border-left: 6px solid #9b59b6; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
          <span style="color: #666; font-size: 0.8em; font-weight: bold; text-transform: uppercase;">Mínimo Pav. Novo: <%= @produto.limite_pavilhao_novo.to_f %></span>
          <h4 style="margin: 5px 0 2px 0; color: #333; font-size: 1.1em;">Pavilhão Novo</h4>
          <strong style="font-size: 1.8em; color: <%= @produto.estoque_pavilhao_novo_baixo? ? '#D71920' : '#9b59b6' %>;">
            <%= @produto.estoque_pavilhao_novo.to_f %> <span style="font-size: 0.5em;"><%= @produto.unidade_medida %></span>
          </strong>
          <%= "⚠️ Reposição" if @produto.estoque_pavilhao_novo_baixo? %>
        </div>

        <%# PAVILHÃO ANTIGO %>
        <div style="flex: 1; min-width: 180px; background: #f4f6f7; padding: 15px; border-radius: 12px; border-left: 6px solid #7f8c8d; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
          <span style="color: #666; font-size: 0.8em; font-weight: bold; text-transform: uppercase;">Mínimo Pav. Ant: <%= @produto.limite_pavilhao_antigo.to_f %></span>
          <h4 style="margin: 5px 0 2px 0; color: #333; font-size: 1.1em;">Pavilhão Antigo</h4>
          <strong style="font-size: 1.8em; color: <%= @produto.estoque_pavilhao_antigo_baixo? ? '#D71920' : '#7f8c8d' %>;">
            <%= @produto.estoque_pavilhao_antigo.to_f %> <span style="font-size: 0.5em;"><%= @produto.unidade_medida %></span>
          </strong>
          <%= "⚠️ Reposição" if @produto.estoque_pavilhao_antigo_baixo? %>
        </div>
      </div>

      <%# Blocos Financeiros Inteligentes %>
      <div style="display: flex; gap: 20px; margin: 25px 0; flex-wrap: wrap; clear: both; text-align: left;">
        
        <% if @produto.categoria == "Venda" %>
          <%# --- VISÃO PARA PRODUTOS DE VENDA --- %>
          <div style="flex: 1; min-width: 200px; background: #e3f2fd; padding: 15px; border-radius: 12px; border-left: 6px solid #2196f3;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Preço de Venda</span>
            <h3 style="margin: 5px 0; color: #0d47a1; font-size: 1.6em;"><%= number_to_currency(@produto.preco_venda, unit: "R$ ", separator: ",", delimiter: ".") %></h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #fff3e0; padding: 15px; border-radius: 12px; border-left: 6px solid #ff9800;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Custo de Production</span>
            <h3 style="margin: 5px 0; color: #e65100; font-size: 1.6em;">
              <% custo_total = @produto.composicoes.sum do |c| 
                    qtd = c.quantidade.to_f
                    preco_insumo = c.insumo.valor_unitario.to_f
                    unidade = c.unidade_medida_uso.to_s.downcase
                    
                    if ['gramas', 'ml'].include?(unidade)
                      (qtd / 1000.0) * preco_insumo
                    elsif ['unidade', 'fatia', 'rodela', 'folha'].include?(unidade)
                      fator = c.insumo.media_unidades_kg.to_f > 0 ? c.insumo.media_unidades_kg.to_f : 1.0
                      (qtd / fator) * preco_insumo
                    else
                      qtd * preco_insumo
                    end
                  end 
              %>
              <%= number_to_currency(custo_total, unit: "R$ ", separator: ",", delimiter: ".") %>
            </h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #e8f5e9; padding: 15px; border-radius: 12px; border-left: 6px solid #4caf50;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Lucro p/ Unidade</span>
            <h3 style="margin: 5px 0; color: #1b5e20; font-size: 1.6em;">
              <%= number_to_currency(@produto.preco_venda.to_f - custo_total, unit: "R$ ", separator: ",", delimiter: ".") %>
            </h3>
          </div>

        <% else %>
          <%# --- VISÃO PARA INSUMOS --- %>
          <div style="flex: 1; min-width: 200px; background: #f1f8e9; padding: 15px; border-radius: 12px; border-left: 6px solid #8bc34a;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Custo de Aquisição</span>
            <h3 style="margin: 5px 0; color: #33691e; font-size: 1.6em;"><%= number_to_currency(@produto.valor_unitario, unit: "R$ ", separator: ",", delimiter: ".") %></h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #fffde7; padding: 15px; border-radius: 12px; border-left: 6px solid #fbc02d;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Fator (Unid/Kg ou L)</span>
            <h3 style="margin: 5px 0; color: #f57f17; font-size: 1.6em;"><%= @produto.media_unidades_kg %></h3>
          </div>
        <% end %>
      </div>

      <%# --- DESTRUIÇÃO REMOVIDA DAQUI E FORMULÁRIO TAMBÉM --- %>

      <div style="margin-top: 50px; border-top: 1px solid #eee; padding-top: 20px; text-align: left;">
        <%= button_to "Excluir este produto permanentemente", @produto, method: :delete, data: { confirm: "Atenção: Esta ação não pode ser desfeita. Confirmar exclusão?" }, style: "background: #ff4444; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; opacity: 0.7; font-size: 0.9em;" %>
      </div>
    <% end %>
  </div>
</div>