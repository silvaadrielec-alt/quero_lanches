<p style="color: green"><%= notice %></p>

<div class="container-estoque" style="max-width: 900px; margin: 0 auto; padding: 20px;">
  <%# Renderiza o partial _produto.html.erb que já ajustamos %>
  <%= render @produto %>

  <div style="margin-top: 20px;">
    <% if current_funcionario.admin? %>
      <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <%= link_to "← Voltar para Produtos", produtos_path, style: "color: #0000FF; text-decoration: underline; font-family: sans-serif; font-weight: bold;" %>
        <%= link_to 'Editar este produto', edit_produto_path(@produto), style: "color: #0000FF; text-decoration: underline; font-family: sans-serif;" %>
      </div>
      
      <%# Blocos Financeiros Inteligentes %>
      <div style="display: flex; gap: 20px; margin: 25px 0; flex-wrap: wrap; clear: both;">
        
        <% if @produto.categoria == "Venda" %>
          <%# --- VISÃO PARA PRODUTOS DE VENDA --- %>
          <div style="flex: 1; min-width: 200px; background: #e3f2fd; padding: 15px; border-radius: 12px; border-left: 6px solid #2196f3;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Preço de Venda</span>
            <h3 style="margin: 5px 0; color: #0d47a1; font-size: 1.6em;"><%= number_to_currency(@produto.preco_venda) %></h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #fff3e0; padding: 15px; border-radius: 12px; border-left: 6px solid #ff9800;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Custo de Produção</span>
            <h3 style="margin: 5px 0; color: #e65100; font-size: 1.6em;">
              <%# Lógica de conversão para cálculo de custo real %>
              <% custo_total = @produto.composicoes.sum do |c| 
                   qtd = c.quantidade.to_f
                   preco_insumo = c.insumo.valor_unitario.to_f
                   unidade = c.unidade_medida_uso.to_s.downcase
                   
                   if ['gramas', 'ml'].include?(unidade)
                     (qtd / 1000.0) * preco_insumo
                   elsif ['unidade', 'fatia', 'rodela', 'folha'].include?(unidade)
                     fator = c.insumo.media_unidades_kg.to_f > 0 ? c.insumo.media_unidades_kg.to_f : 1.0
                     (qtd / fator) * preco_insumo
                   else
                     qtd * preco_insumo
                   end
                 end 
              %>
              <%= number_to_currency(custo_total) %>
            </h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #e8f5e9; padding: 15px; border-radius: 12px; border-left: 6px solid #4caf50;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Lucro p/ Unidade</span>
            <h3 style="margin: 5px 0; color: #1b5e20; font-size: 1.6em;">
              <%= number_to_currency(@produto.preco_venda.to_f - custo_total) %>
            </h3>
          </div>

        <% else %>
          <%# --- VISÃO PARA INSUMOS --- %>
          <div style="flex: 1; min-width: 200px; background: #f1f8e9; padding: 15px; border-radius: 12px; border-left: 6px solid #8bc34a;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Custo de Aquisição</span>
            <h3 style="margin: 5px 0; color: #33691e; font-size: 1.6em;"><%= number_to_currency(@produto.valor_unitario) %></h3>
          </div>

          <div style="flex: 1; min-width: 200px; background: #fffde7; padding: 15px; border-radius: 12px; border-left: 6px solid #fbc02d;">
            <span style="color: #666; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Fator (Unid/Kg ou L)</span>
            <h3 style="margin: 5px 0; color: #f57f17; font-size: 1.6em;"><%= @produto.media_unidades_kg %></h3>
          </div>
        <% end %>
      </div>

      <%# Exibe a Ficha Técnica apenas se for um item de Venda %>
      <% if @produto.categoria == "Venda" %>
        <hr style="margin-top: 40px; border: 1px solid #eee;">
        <h3 style="color: #D71920; font-weight: bold; font-family: sans-serif;">📋 Ficha Técnica / Receita</h3>
        
        <table class="table" style="width: 100%; margin-top: 20px; border-collapse: collapse; font-family: sans-serif;">
          <thead style="background-color: #f8f8f8;">
            <tr>
              <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ddd;">Insumo</th>
              <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ddd;">Qtd. Gasta</th>
              <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ddd;">Medida Uso</th>
              <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ddd;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @produto.composicoes.each do |comp| %>
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;"><%= comp.insumo.nome %></td>
                <td style="padding: 10px;"><%= comp.quantidade %></td>
                <td style="padding: 10px;">
                  <span style="background: #17a2b8; color: white; padding: 4px 8px; border-radius: 5px; font-size: 0.9em;">
                    <%= comp.unidade_medida_uso %>
                  </span>
                </td>
                <td style="padding: 10px;">
                  <%= button_to 'Remover', composico_path(comp), method: :delete, data: { confirm: 'Deseja remover este insumo da receita?' }, style: "background: none; border: none; color: #ff4444; cursor: pointer; text-decoration: underline;" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%# Formulário para adicionar insumos à receita %>
        <div style="background: #fdf8f5; padding: 20px; border-radius: 12px; margin-top: 20px; border: 1px dashed #D71920; font-family: sans-serif;">
          <h4 style="margin-top: 0; color: #333;">Adicionar Insumo à Receita</h4>
          <%= form_with(model: [ @produto, Composicao.new ], url: produto_composicoes_path(@produto)) do |f| %>
            <div style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;">
              <div style="flex: 2; min-width: 200px;">
                <%= f.label :insumo_id, "Insumo", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
                <%= f.collection_select :insumo_id, Produto.where(categoria: "Insumo"), :id, :nome, { prompt: "Selecione um insumo..." }, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
              </div>
              <div style="flex: 1; min-width: 80px;">
                <%= f.label :quantidade, "Qtd.", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
                <%= f.number_field :quantidade, step: :any, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
              </div>
              <div style="flex: 1; min-width: 120px;">
                <%= f.label :unidade_medida_uso, "Medida", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
                <%= f.select :unidade_medida_uso, ['unidade', 'fatia', 'rodela', 'folha', 'kg', 'gramas', 'ml'], {}, style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc;" %>
              </div>
              <%= f.submit "Adicionar", style: "background: #28a745; color: white; padding: 11px 25px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold;" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div style="margin-top: 50px; border-top: 1px solid #eee; padding-top: 20px;">
        <%= button_to "Excluir este produto permanentemente", @produto, method: :delete, data: { confirm: "Atenção: Esta ação não pode ser desfeita. Confirmar exclusão?" }, style: "background: #ff4444; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; opacity: 0.7; font-size: 0.9em;" %>
      </div>
    <% end %>
  </div>
</div>