<%# BOTÃO EXECUTIVO COMPACTO DE RETORNO NO TOPO %>
<div style="max-width: 900px; margin: 20px auto 15px auto; padding: 0 20px; box-sizing: border-box; text-align: left;">
  <%= link_to produtos_path, style: "background: #f1f5f9; color: #0000FF; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 11px; text-decoration: none; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px; font-family: sans-serif;" do %>
    ← VOLTAR PARA PRODUTOS
  <% end %>
</div>

<%# CARD PRINCIPAL CENTRALIZADO COM MOLDURA VERMELHA OFICIAL %>
<div class="card-principal" style="max-width: 900px; margin: 0 auto 40px auto; padding: 35px; background: #fff; border-radius: 12px; border: 2px solid #D71920 !important; box-shadow: 0 4px 15px rgba(0,0,0,0.06); font-family: sans-serif; box-sizing: border-box;">
  
  <%# Renderiza o partial original polido (Nome, Custo e Estoque) %>
  <div style="margin-bottom: 35px; text-align: left; box-sizing: border-box;">
    <%= render @produto %>
  </div>

  <% if current_funcionario.admin? %>
    
    <%# SEÇÃO 1: SITUAÇÃO DE ESTOQUE POR UNIDADE %>
    <h3 style="color: #D71920; font-weight: bold; font-size: 13px; margin-bottom: 15px; text-align: left; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
      Situação de Estoque
    </h3>

    <% if @produto.composicoes.any? %>
      <% # Cenário A: Produto produzido na hora que consome matérias-primas %>
      <div style="background-color: #f8fafc; padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; border-left: 4px solid #D71920; box-sizing: border-box; text-align: left; margin-bottom: 40px;">
        <span style="font-size: 13px; color: #1e293b; font-weight: bold; display: block; margin-bottom: 4px; text-transform: uppercase;">Item de Fabricação Interna</span>
        <p style="margin: 0; font-size: 12px; color: #64748b; font-style: italic; font-weight: 500; line-height: 1.4;">
          Este item não possui saldo de estoque direto por ser produzido na cantina. Toda venda realizada registrará baixas fracionadas e automáticas diretamente nas matérias-primas configuradas em sua Ficha Técnica.
        </p>
      </div>
    <% else %>
      <% # Cenário B: Item de revenda direta com quantidades reais e paleta azul %>
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 40px; box-sizing: border-box;">
        
        <%# MATRIZ CENTRO %>
        <% bg_centro = @produto.estoque_centro_baixo? ? '#fef2f2' : '#e0f2fe' %>
        <% border_centro = @produto.estoque_centro_baixo? ? '#fee2e2' : '#bae6fd' %>
        <% bar_centro = @produto.estoque_centro_baixo? ? '#dc2626' : '#0284c7' %>
        <div style="background-color: <%= bg_centro %>; padding: 15px; border-radius: 8px; border: 1px solid <%= border_centro %>; text-align: left; box-sizing: border-box; border-left: 4px solid <%= bar_centro %>;">
          <span style="color: #475569; font-size: 10px; font-weight: bold; text-transform: uppercase; display: block; letter-spacing: 0.3px;">
            Mínimo Matriz: <%= number_with_precision(@produto.limite_centro, precision: 0) %>
          </span>
          <strong style="font-size: 1.6em; color: <%= @produto.estoque_centro_baixo? ? '#dc2626' : '#1e293b' %>; display: block; margin-top: 5px; font-weight: bold;">
            <%= number_with_precision(@produto.estoque_centro, precision: 0) %> <span style="font-size: 12px; color: #475569; font-weight: normal;"><%= @produto.unidade_medida %></span>
          </strong>
          <span style="font-size: 11px; color: <%= @produto.estoque_centro_baixo? ? '#dc2626' : '#0369a1' %>; font-weight: bold; display: block; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.3px;">
            <%= @produto.estoque_centro_baixo? ? "⚠️ Reposição" : "Matriz Centro" %>
          </span>
        </div>

        <%# PAVILHÃO NOVO %>
        <% bg_novo = @produto.estoque_pavilhao_novo_baixo? ? '#fef2f2' : '#e0f2fe' %>
        <% border_novo = @produto.estoque_pavilhao_novo_baixo? ? '#fee2e2' : '#bae6fd' %>
        <% bar_novo = @produto.estoque_pavilhao_novo_baixo? ? '#dc2626' : '#0284c7' %>
        <div style="background-color: <%= bg_novo %>; padding: 15px; border-radius: 8px; border: 1px solid <%= border_novo %>; text-align: left; box-sizing: border-box; border-left: 4px solid <%= bar_novo %>;">
          <span style="color: #475569; font-size: 10px; font-weight: bold; text-transform: uppercase; display: block; letter-spacing: 0.3px;">
            Mínimo Pav. Novo: <%= number_with_precision(@produto.limite_pavilhao_novo, precision: 0) %>
          </span>
          <strong style="font-size: 1.6em; color: <%= @produto.estoque_pavilhao_novo_baixo? ? '#dc2626' : '#1e293b' %>; display: block; margin-top: 5px; font-weight: bold;">
            <%= number_with_precision(@produto.estoque_pavilhao_novo, precision: 0) %> <span style="font-size: 12px; color: #475569; font-weight: normal;"><%= @produto.unidade_medida %></span>
          </strong>
          <span style="font-size: 11px; color: <%= @produto.estoque_pavilhao_novo_baixo? ? '#dc2626' : '#0369a1' %>; font-weight: bold; display: block; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.3px;">
            <%= @produto.estoque_pavilhao_novo_baixo? ? "⚠️ Reposição" : "Pavilhão Novo" %>
          </span>
        </div>

        <%# PAVILHÃO ANTIGO %>
        <% bg_antigo = @produto.estoque_pavilhao_antigo_baixo? ? '#fef2f2' : '#e0f2fe' %>
        <% border_antigo = @produto.estoque_pavilhao_antigo_baixo? ? '#fee2e2' : '#bae6fd' %>
        <% bar_antigo = @produto.estoque_pavilhao_antigo_baixo? ? '#dc2626' : '#0284c7' %>
        <div style="background-color: <%= bg_antigo %>; padding: 15px; border-radius: 8px; border: 1px solid <%= border_antigo %>; text-align: left; box-sizing: border-box; border-left: 4px solid <%= bar_antigo %>;">
          <span style="color: #475569; font-size: 10px; font-weight: bold; text-transform: uppercase; display: block; letter-spacing: 0.3px;">
            Mínimo Pav. Ant: <%= number_with_precision(@produto.limite_pavilhao_antigo, precision: 0) %>
          </span>
          <strong style="font-size: 1.6em; color: <%= @produto.estoque_pavilhao_antigo_baixo? ? '#dc2626' : '#1e293b' %>; display: block; margin-top: 5px; font-weight: bold;">
            <%= number_with_precision(@produto.estoque_pavilhao_antigo, precision: 0) %> <span style="font-size: 12px; color: #475569; font-weight: normal;"><%= @produto.unidade_medida %></span>
          </strong>
          <span style="font-size: 11px; color: <%= @produto.estoque_pavilhao_antigo_baixo? ? '#dc2626' : '#0369a1' %>; font-weight: bold; display: block; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.3px;">
            <%= @produto.estoque_pavilhao_antigo_baixo? ? "⚠️ Reposição" : "Pavilhão Antigo" %>
          </span>
        </div>
      </div>
    <% end %>

    <%# LÓGICA DO CUSTO DE PRODUÇÃO DINÂMICO %>
    <% custo_total = @produto.composicoes.sum do |c| 
          qtd = c.quantidade.to_f
          preco_insumo = c.insumo.preco_venda.to_f 
          unidade = c.unidade_medida_uso.to_s.downcase
          
          if ['gramas', 'ml'].include?(unidade)
            (qtd / 1000.0) * preco_insumo
          elsif ['unidade', 'fatia', 'rodela', 'folha'].include?(unidade)
            fator = c.insumo.media_unidades_kg.to_f > 0 ? c.insumo.media_unidades_kg.to_f : 1.0
            (qtd / fator) * preco_insumo
          else
            qtd * preco_insumo
          end
        end 
    %>

    <%# SEÇÃO 2: PRECIFICAÇÃO E LUCRO %>
    <% if @produto.respond_to?(:variacao_produtos) && @produto.variacao_produtos.any? %>
      
      <h3 style="color: #D71920; font-weight: bold; font-size: 13px; margin-bottom: 20px; text-align: left; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
        Precificação e Lucro por Tamanho / Volume
      </h3>
      
      <%# LISTAGEM EM FILAS EXECUTIVAS BEM DELIMITADAS %>
      <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 40px; box-sizing: border-box;">
        <% @produto.variacao_produtos.each do |variacao| %>
          <div style="border: 1px solid #e2e8f0; padding: 20px; border-radius: 8px; text-align: left; box-sizing: border-box; background: #fff; border-bottom: 2px solid #cbd5e1;">
            
            <%# TÍTULO DA VARIAÇÃO %>
            <div style="margin-bottom: 14px; border-bottom: 1px dashed #e2e8f0; padding-bottom: 6px;">
              <span style="display: block; font-size: 10px; color: #64748b; font-weight: bold; text-transform: uppercase; letter-spacing: 0.3px;">Tamanho / Volume</span>
              <strong style="font-size: 1.2em; color: #1e293b;"><%= variacao.tamanho.upcase %></strong>
            </div>

            <%# GRID EXECUTIVO DE DADOS FINANCEIROS %>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; box-sizing: border-box;">
              <div>
                <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 3px;">Custo Total</span>
                <span style="font-size: 1.1em; color: #b45309; font-weight: bold;">
                  <%= number_to_currency(custo_total, unit: "R$ ", separator: ",", delimiter: ".") %>
                </span>
              </div>

              <div>
                <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 3px;">Preço Venda</span>
                <span style="font-size: 1.1em; color: #1d4ed8; font-weight: bold;">
                  <%= number_to_currency(variacao.preco_venda, unit: "R$ ", separator: ",", delimiter: ".") %>
                </span>
              </div>

              <div>
                <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 3px;">Lucro Líquido</span>
                <% lucro_var = variacao.preco_venda.to_f - custo_total %>
                <span style="font-size: 1.1em; color: <%= lucro_var >= 0 ? '#16a34a' : '#dc2626' %>; font-weight: bold;">
                  <%= number_to_currency(lucro_var, unit: "R$ ", separator: ",", delimiter: ".") %>
                </span>
              </div>
            </div>

          </div>
        <% end %>
      </div>

    <% else %>
      
      <%# SEÇÃO 2 ALTERNATIVA: SEM VARIAÇÕES %>
      <h3 style="color: #D71920; font-weight: bold; font-size: 13px; margin-bottom: 15px; text-align: left; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
        Valores e Custos Gerais
      </h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 40px; text-align: left; box-sizing: border-box;">
        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
          <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px;">Preço de Venda</span>
          <span style="font-size: 1.2em; color: #1d4ed8; font-weight: bold;">
            <%= number_to_currency(@produto.preco_venda, unit: "R$ ", separator: ",", delimiter: ".") %>
          </span>
        </div>

        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
          <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px;">Custo de Produção</span>
          <span style="font-size: 1.2em; color: #b45309; font-weight: bold;">
            <%= number_to_currency(custo_total, unit: "R$ ", separator: ",", delimiter: ".") %>
          </span>
        </div>

        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
          <span style="display: block; font-size: 11px; color: #64748b; font-weight: bold; text-transform: uppercase; margin-bottom: 4px;">Lucro p/ Unidade</span>
          <% lucro_simples = @produto.preco_venda.to_f - custo_total %>
          <span style="font-size: 1.2em; color: <%= lucro_simples >= 0 ? '#16a34a' : '#dc2626' %>; font-weight: bold;">
            <%= number_to_currency(lucro_simples, unit: "R$ ", separator: ",", delimiter: ".") %>
          </span>
        </div>
      </div>

    <% end %>

    <%# BOTÕES DE AÇÃO PARALELOS PREMIUM (ALINHAMENTO BLINDADO) %>
    <div style="display: flex; gap: 15px; justify-content: center; align-items: stretch; border-top: 1px solid #f1f5f9; padding-top: 25px; margin-top: 20px; width: 100%;">
      
      <%# BOTÃO EDITAR (LINK_TO) %>
      <%= link_to 'EDITAR PRODUTO', edit_produto_path(@produto), 
          style: "background-color: #D71920; color: white; padding: 14px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 13px; box-shadow: 0 4px 10px rgba(215, 25, 32, 0.18); text-align: center; flex: 1; text-transform: uppercase; letter-spacing: 0.5px; box-sizing: border-box; display: flex; align-items: center; justify-content: center;" %>
          
      <%= botao_excluir @produto, texto: 'EXCLUIR PRODUTO', mensagem: 'Atenção: Esta ação não pode ser desfeita. Confirmar exclusão?',
      estilo: "flex: 1; background: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; padding: 14px 25px; border-radius: 8px; font-weight: bold; font-size: 13px; text-transform: uppercase; text-align: center; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;" %>
      
    </div>

  <% end %>
</div>